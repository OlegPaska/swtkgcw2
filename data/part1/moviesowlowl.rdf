    <!-- http://www.city.ac.uk/inm713-in3067/2026/Oleg_Paska/IMDB_Rating -->

    <owl:DatatypeProperty rdf:about="http://www.city.ac.uk/inm713-in3067/2026/Oleg_Paska/IMDB_Rating">
        <rdfs:domain rdf:resource="http://www.city.ac.uk/inm713-in3067/2026/Oleg_Paska/Movie"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


