  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_War">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">renewed war</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Wars"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">war broke&amp;nbsp;</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">out</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Great Galactic War</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">The Galactic War was a war that broke after the collapse of the peace treaty between the Sith Empire and the Galactic Republic. After twelve years of tenuous peace in the form of the Cold War, the actions of several powerful individuals caused conflict to break out once more between the major galactic powers.
This war is the main setting of Star Wars The Old Republic.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <ns5:abstract xml:lang="en">The Galactic War was a war that broke after the collapse of the peace treaty between the Sith Empire and the Galactic Republic. After twelve years of tenuous peace in the form of the Cold War, the actions of several powerful individuals caused conflict to break out once more between the major galactic powers.
This war is the main setting of Star Wars The Old Republic.</ns5:abstract>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Second Great Galactic War</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">all out war</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Second Great Galactic War</ns5:wikiPageWikiLinkText>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/CA_20100212_Taris01_full.jpg"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/GTN.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Treaty_of_Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic War</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic War</ns4:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Wars"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic War</rdfs:label>
