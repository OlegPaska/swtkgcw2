    <ns1:apprentice rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kaal"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Inquisitors"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith"/>
