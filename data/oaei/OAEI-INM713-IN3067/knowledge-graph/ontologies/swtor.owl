    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Makeb"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unidentified</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns1:passengers rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Refugees</ns1:passengers>
    <rdfs:comment xml:lang="en">A large transport carrying refugees during the Mandalorian Wars, crash-landed on the planet Makeb. The refugees decided to stay and colonize the planet when they discovered they were unable to escape Makeb's unique atmosphere.

</rdfs:comment>
