    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fires a charge of lightning at the target, deals 1914-2041 energy damage.</ns1:description>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning Strike</ns1:link>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/lightningstrike.png?width=300"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning Strike</rdfs:label>
