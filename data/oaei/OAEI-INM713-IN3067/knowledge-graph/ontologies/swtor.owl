    <ns1:faction rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Republic</ns1:faction>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Weaken_Mind"/>
