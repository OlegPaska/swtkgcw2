  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lucky_Lancer">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lucky_Lancer.png?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lucky_Lancer.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lucky Lancer</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Great_Galactic_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Corellia"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lore/Starships"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/starship"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Republic</ns1:allegiance>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Shuttles"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lucky Lancer</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Codex/Lore"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shuttle</ns1:type>
    <ns5:abstract xml:lang="en">The Lucky Lancer was a Rendaran-class assault shuttle famous for surviving over one hundred combat missions during the Great Galactic War. After it was retired, the Lucky Lancer was preserved in the Corellian Museum of Starships. During the Cold War, the Trooper had to decide whether to have it moved or destroyed, in order to secure a landing zone for the Republic Army.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Lucky_Lancer.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Swtor_2014-10-17_13-08-44-29.png"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Great_Galactic_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Rendaran-class_assault_shuttle"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Corellian_Museum_of_Starships"/>
    <rdfs:comment xml:lang="en">The Lucky Lancer was a Rendaran-class assault shuttle famous for surviving over one hundred combat missions during the Great Galactic War. After it was retired, the Lucky Lancer was preserved in the Corellian Museum of Starships. During the Cold War, the Trooper had to decide whether to have it moved or destroyed, in order to secure a landing zone for the Republic Army.

</rdfs:comment>
