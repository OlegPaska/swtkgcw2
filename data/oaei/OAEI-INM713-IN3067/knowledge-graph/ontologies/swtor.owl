  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gate_Commander_Draxus">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Gate Commander Draxus</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bosses"/>
    <ns1:race rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Human</ns1:race>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Operation_Bosses"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Operation_Bosses"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/npc"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Dread_Fortress"/>
    <rdfs:comment xml:lang="en">Gate Commander Draxus is the second boss in Operation The Dread Fortress. Before you can fight the boss itself, you must first make your way through a labyrinth like puzzle. Divide your group into 2 groups and split them into pairs afterwards. Each pair will then take a different route. You need to activate the crystals here to open gates for others. Once you have cleared the puzzle, you'll find the boss.

</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Gate_Commander.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Oricon"/>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Boss</ns1:class>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Male</ns1:gender>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Dread_Fortress"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bosses"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Dread_Fortress"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">55</ns1:level>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Gate Commander Draxus</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Oricon"/>
    <ns5:abstract xml:lang="en">Gate Commander Draxus is the second boss in Operation The Dread Fortress. Before you can fight the boss itself, you must first make your way through a labyrinth like puzzle. Divide your group into 2 groups and split them into pairs afterwards. Each pair will then take a different route. You need to activate the crystals here to open gates for others. Once you have cleared the puzzle, you'll find the boss.

</ns5:abstract>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Gate Commander Draxus</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Gate Commander Draxus</ns4:altLabel>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Gate_Commander.jpg?width=300"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Dread_Fortress"/>
  </rdf:Description>
