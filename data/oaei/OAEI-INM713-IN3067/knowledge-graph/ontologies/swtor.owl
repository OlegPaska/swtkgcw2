  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Journey_into_Dust">
    <ns1:previous rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:previous>
