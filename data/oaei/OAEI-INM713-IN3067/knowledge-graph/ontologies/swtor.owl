    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-10-18_10-37-57-19.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sand Person</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tatooine"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ghorfa</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Species"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sand People</rdfs:label>
    <rdfs:comment xml:lang="en">The Sand People are a tribal species native to Tatooine. They are generally aggressive towards strangers. They have a strong spiritual culture, which is led by shamans who know many of the deserts myths. Their robes are spiritual clothing that is never removed throughout their whole lives. The headmask contains a filter for breathing during the rough sandstorms and the additional clothing helps protect them. Sand people have been around ever since before the fall of the Infinite Empire.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Neutral_Guilds"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Neutral_Guilds"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-10-24_18-44-05-02.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tatooine"/>
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Neutral</ns1:allegiance>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tusken Raiders</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Creatures"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tatooine"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:abstract xml:lang="en">The Sand People are a tribal species native to Tatooine. They are generally aggressive towards strangers. They have a strong spiritual culture, which is led by shamans who know many of the deserts myths. Their robes are spiritual clothing that is never removed throughout their whole lives. The headmask contains a filter for breathing during the rough sandstorms and the additional clothing helps protect them. Sand people have been around ever since before the fall of the Infinite Empire.

</ns5:abstract>
