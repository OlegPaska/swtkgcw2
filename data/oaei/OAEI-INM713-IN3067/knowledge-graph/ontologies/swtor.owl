  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Grathan">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dromund_Kaas"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Cold_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ralesk"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lordgrathan.png"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Council"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Beelzlit_Grathan"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Warriors"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Grathan</ns4:altLabel>
    <rdfs:comment xml:lang="en">Grathan is a male human Sith Lord who served the Sith Empire during the Cold War. He was known for having rebelled against the Sith and Dark Council, creating his own army of loyal imperial troops, battle droids and was even capable of moving people's minds into droid bodies, his own cybernetic supersoldiers. 

</rdfs:comment>
    <ns1:species rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/BioWare"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</ns1:level>
    <ns1:apprentice rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ralesk"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Cold_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Warrior"/>
    <ns5:abstract xml:lang="en">Grathan is a male human Sith Lord who served the Sith Empire during the Cold War. He was known for having rebelled against the Sith and Dark Council, creating his own army of loyal imperial troops, battle droids and was even capable of moving people's minds into droid bodies, his own cybernetic supersoldiers. 

</ns5:abstract>
