  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Pyrotech_(Skill_Tree)">
    <ns5:abstract xml:lang="en">Pyrotech is the shared skill tree of the Bounty Hunter. This tree focuses on ranged damage.
The following table contains the known skills that can be gained from this tree:

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Prototype_Particle_Accelerator.png"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Firebug</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Powertech"/>
