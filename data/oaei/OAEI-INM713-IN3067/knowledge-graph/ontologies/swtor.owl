  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Intelligence_Gadget_Warehouse">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Imperial Intelligence Gadget Warehouse</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Imperial Intelligence Gadget Warehouse</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Archaeology"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/fact"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nar_Shaddaa"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lower_Industrial_Sector"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lore#Imperial_Intelligence_Gadget_Warehouse"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Upper_Office_Atrium"/>
    <rdfs:comment xml:lang="en">Imperial Intelligence Gadget Warehouse is an area of the Industrial Sector on Nar Shaddaa.
Most of the area is Empire friendly.  The exceptions are the westmost hallway leading to the Lower Industrial Sector and the Workers' Quarters area. Empire characters can find resourcs for Slicing and Archaeology, as well lootable chests in the area that require no confrontation to obtain.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Re-education_Center"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Slicing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/High_Security_Lockdown"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Imperial_Edict.jpg"/>
    <ns5:abstract xml:lang="en">Imperial Intelligence Gadget Warehouse is an area of the Industrial Sector on Nar Shaddaa.
Most of the area is Empire friendly.  The exceptions are the westmost hallway leading to the Lower Industrial Sector and the Workers' Quarters area. Empire characters can find resourcs for Slicing and Archaeology, as well lootable chests in the area that require no confrontation to obtain.

</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Imperial Intelligence Gadget Warehouse</rdfs:label>
  </rdf:Description>
