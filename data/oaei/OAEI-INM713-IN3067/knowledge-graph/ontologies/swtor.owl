  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Reflexive_Shield">
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <rdfs:comment xml:lang="en">When you take damage, you have 50% chance to reduce the active cooldown of Reactive Shield by 1.5 seconds. This effect cannot occur more than once every 1.5 seconds. In addition, when taking damage, you have a 10% chance to emit an Energy Redoubt, which absorbs a low amount of damage and lasts 6 seconds. This effect cannot occur more than once every 10 seconds.

</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reflexive Shield</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesammo"/>
    <ns1:cells rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cells>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Reflexive_Shield.PNG"/>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Commando</ns1:class>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reflexive Shield</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns5:abstract xml:lang="en">When you take damage, you have 50% chance to reduce the active cooldown of Reactive Shield by 1.5 seconds. This effect cannot occur more than once every 1.5 seconds. In addition, when taking damage, you have a 10% chance to emit an Energy Redoubt, which absorbs a low amount of damage and lasts 6 seconds. This effect cannot occur more than once every 10 seconds.

</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Reflexive_Shield.png"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reflexive Shield</ns1:name>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Reflexive_Shield.png?width=300"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">When you take damage, you have [50 / 100]% chance to reduce the active cooldown of Reactive Shield by [1.5 / 3] seconds. This effect cannot occur more than once every 1.5 seconds. In addition, when taking damage, you have a [10 / 20]% chance to emit an Energy Redoubt, which absorbs a low amount of damage and lasts 6 seconds. This effect cannot occur more than once every 10 seconds.</ns1:description>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Reflexive_Shield.PNG"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reflexive Shield</ns4:altLabel>
  </rdf:Description>
