  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Swoopstriker">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-10-21_09-56-32-57.png"/>
    <ns5:abstract xml:lang="en">The Swoopstrikers are aggressive flying creatures that inhabit Balmorra. They have large bat-like wings and four legs. They can often be seen in groups, but have been known to wander solo.

</ns5:abstract>
