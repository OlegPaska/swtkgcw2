    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Sedatives.PNG"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sedatives</ns4:altLabel>
    <ns5:abstract xml:lang="en">When Sleep Dart wears off, the target is struck by Sedatives, reducing all damage dealt by 25% for the next 10 seconds.

</ns5:abstract>
    <rdfs:comment xml:lang="en">When Sleep Dart wears off, the target is struck by Sedatives, reducing all damage dealt by 25% for the next 10 seconds.

</rdfs:comment>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sedatives.png?width=300"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sedatives</rdfs:label>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sedatives</ns1:name>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">When Sleep Dart wears off, the target is struck by Sedatives, reducing all damage dealt by [25 / 50]% for the next 10 seconds.</ns1:description>
