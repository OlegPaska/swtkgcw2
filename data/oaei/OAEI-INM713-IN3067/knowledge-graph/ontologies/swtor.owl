  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_instructor">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">handlers</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi instructor</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Master"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi instructor</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Initiate"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Guardian"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <rdfs:comment xml:lang="en">Jedi instructors are Jedi Masters that taught the Initiates and Padawans of the Jedi Order. Specializing in different fields, including politics, lightsaber combat, unarmed combat, and the sciences, these Jedi drew from both the Guardian and Consular branches of the Jedi Knights. Most Jedi instructors had considerable aptitude in a variety of skills that helped to maintain the Jedi's numbers. Particularly, Jedi instructors were adept at identifying an Initiate's weak points, preventing their students from falling to the dark side, and helping young Jedi determine the role they would best fit in the Order.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Consular"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi"/>
    <ns5:abstract xml:lang="en">Jedi instructors are Jedi Masters that taught the Initiates and Padawans of the Jedi Order. Specializing in different fields, including politics, lightsaber combat, unarmed combat, and the sciences, these Jedi drew from both the Guardian and Consular branches of the Jedi Knights. Most Jedi instructors had considerable aptitude in a variety of skills that helped to maintain the Jedi's numbers. Particularly, Jedi instructors were adept at identifying an Initiate's weak points, preventing their students from falling to the dark side, and helping young Jedi determine the role they would best fit in the Order.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Padawan"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_instructors"/>
