  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nice_Try">
    <ns1:energy rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:energy>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Nice_Try.PNG"/>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Smuggler</ns1:class>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nice Try</rdfs:label>
    <ns5:abstract xml:lang="en">Reduces the damage taken by periodic effects by 15%. In addition, when Vital Shot or Sharp Bomb end, they are replaced by a weaker version of that same effect that deals 15% of the original effect's damage over 9 seconds. Damage dealt by these weak versions does not remove the target from stealth.</ns5:abstract>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nice Try</ns1:name>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reduces the damage taken by periodic effects by 15%. In addition, when Vital Shot or Shrap Bomb end, they are replaced by a weaker version of that same effect that deals 15% of the original effect's damage over 9 seconds. Damage dealt by these weak versions does not remove the target from stealth.</ns1:description>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nice Try</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">Reduces the damage taken by periodic effects by 15%. In addition, when Vital Shot or Sharp Bomb end, they are replaced by a weaker version of that same effect that deals 15% of the original effect's damage over 9 seconds. Damage dealt by these weak versions does not remove the target from stealth.</rdfs:comment>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesenergy"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Nice_Try.PNG"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Nice_Try.png?width=300"/>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Nice_Try.png"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nice Try</ns4:altLabel>
  </rdf:Description>
