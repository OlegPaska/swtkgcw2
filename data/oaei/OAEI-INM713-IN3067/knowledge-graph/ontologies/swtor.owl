  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hail_of_Bolts">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hail of Bolts</ns4:altLabel>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hail of Bolts</ns1:name>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:resource>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Hail_of_Bolts.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hail of Bolts</ns5:wikiPageWikiLinkText>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Hail_of_Bolts.png?width=300"/>
    <ns1:channel rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">3.0</ns1:channel>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Channeled</ns1:type>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:range>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Hail_of_Bolts.PNG</ns1:icon>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hail of Bolts</rdfs:label>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hail of Bolts</ns1:link>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:cooldown>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Damage</ns1:role>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Launches waves of blaster fire at up to 8 targets within 5 meters of the target area, dealing 2557 weapon damage over the duration.  Standard and weak targets are sometimes knocked back by the hail of bolts.  Requires Assault Cannon.  Spends 32 energy cells over the duration.</ns1:description>
  </rdf:Description>
