    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sky Princess</ns1:name>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Pirate"/>
    <ns5:abstract xml:lang="en">The Sky Princess was a pirate starship commanded by the famed pirate captain Andronikos Revel until his crew mutinied against him and took the ship.


</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
