  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Inventory">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Inventory Module</ns4:altLabel>
    <rdfs:comment xml:lang="en">In Star Wars: The Old Republic, each player character has an inventory in which to store items. The inventory starts out with 3 lines unlocked, with 10 slots on each line for a total of 30 slots. However, the inventory can be upgraded for a sum of credits.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Introspection.png"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/credits"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">inventory</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Inventory</ns4:altLabel>
    <ns5:abstract xml:lang="en">In Star Wars: The Old Republic, each player character has an inventory in which to store items. The inventory starts out with 3 lines unlocked, with 10 slots on each line for a total of 30 slots. However, the inventory can be upgraded for a sum of credits.

</ns5:abstract>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Inventory Module</ns5:wikiPageWikiLinkText>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Inventory</rdfs:label>
  </rdf:Description>
