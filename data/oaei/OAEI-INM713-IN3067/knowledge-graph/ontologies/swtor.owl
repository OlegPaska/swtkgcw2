  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lightning_(Discipline)">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Captain_Lieber.jpg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Lightning is one of the three Disciplines avaible for the Sorcerer Advanced Class. It focuses on long-range burst damage.Of all the Dark Arts of the Sith, little can match the spectacle and devestation of Force Lightning. Summoning pure discharges of pure Force Lightning, the Lightning Sorcerer overwealms enemies with punishing damage from a distance, leaving them shaken and vulnerable--if not dead.
</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sorcerer_Disiplines"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sorcerer_Disiplines"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Disiplines"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning (Discipline)</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning (Discipline)</ns4:altLabel>
    <ns5:abstract xml:lang="en">Lightning is one of the three Disciplines avaible for the Sorcerer Advanced Class. It focuses on long-range burst damage.Of all the Dark Arts of the Sith, little can match the spectacle and devestation of Force Lightning. Summoning pure discharges of pure Force Lightning, the Lightning Sorcerer overwealms enemies with punishing damage from a distance, leaving them shaken and vulnerable--if not dead.
</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Disiplines"/>
  </rdf:Description>
