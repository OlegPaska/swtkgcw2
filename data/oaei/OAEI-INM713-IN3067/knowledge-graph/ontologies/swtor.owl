    <ns1:hp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13175</ns1:hp>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi"/>
    <ns5:abstract xml:lang="en">Master Andria was a Mirialan female Jedi Master, who served the Galactic Republic during the Cold War and Galactic War with the Sith Empire. 

</ns5:abstract>
