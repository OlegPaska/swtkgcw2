  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Clansman%27s_Armor_Set">
    <ns5:abstract xml:lang="en">Mandalorian Clansmen armor was a set of heavy armor used by Mandalorians during the Cold War and the Galactic War. Mandalore the Vindicated wore a red and gold version of this armor during his time as Mandalore.

</ns5:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
