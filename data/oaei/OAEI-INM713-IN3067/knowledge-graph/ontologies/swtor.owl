  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Threat">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Threat</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bestiary"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Taunt"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Threat</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">aggro</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">priority table</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">Threat is the numerical value which measures of a creature's aggression toward a character. It is used to establish a priority ranking of players, which the creature uses to determine whom to fight next in a group. This is referred to as the threat table, and (generally) creatures will attack the player on the top of the their threat table. When a player finds himself in this state (i.e., residing on the top of the table), it is known as having aggro.

</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">threat table</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/reflist"/>
    <ns5:abstract xml:lang="en">Threat is the numerical value which measures of a creature's aggression toward a character. It is used to establish a priority ranking of players, which the creature uses to determine whom to fight next in a group. This is referred to as the threat table, and (generally) creatures will attack the player on the top of the their threat table. When a player finds himself in this state (i.e., residing on the top of the table), it is known as having aggro.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tank"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">threat</ns5:wikiPageWikiLinkText>
