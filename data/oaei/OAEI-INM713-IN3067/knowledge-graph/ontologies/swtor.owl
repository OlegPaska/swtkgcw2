  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Alderaan_Battlezone">
    <rdfs:comment xml:lang="en">The Alderaan Battlezone is the site of most of the recent fighting between the Republic and Imperial forces on Alderaan. Because of the site's vital importance in the war to determine Alderaan's allegiance, Republic and Imperial ground forces have been dispatched to crush the other and secure the site. The lives of both fleets depends on their success ot failure.

</rdfs:comment>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/The_Civil_War_Turret.jpg?width=300"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/The_Civil_War_Map.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Alderaan_Civil_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Alderaan"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Alderaan Battlezone</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzone_Arenas"/>
