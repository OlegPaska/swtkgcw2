    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:level>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lord_Sharoleigh.jpg"/>
    <ns1:faction rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire</ns1:faction>
    <ns1:hp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2145</ns1:hp>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Lords"/>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Female</ns1:gender>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nar_Shaddaa"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Republic_Research_Division"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lord Sharoleigh</ns4:altLabel>
    <rdfs:comment xml:lang="en">{{ #if: |
Lord Sharoleigh, as most Sith, does not approve of teaching Force-sensitive aliens the ways of the Force. However, she's afraid that the Jedi are doing so, increasing the ranks of Jedi on Nar Shaddaa.


</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Females"/>
    <ns1:status rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Alive</ns1:status>
    <ns5:abstract xml:lang="en">{{ #if: |
Lord Sharoleigh, as most Sith, does not approve of teaching Force-sensitive aliens the ways of the Force. However, she's afraid that the Jedi are doing so, increasing the ranks of Jedi on Nar Shaddaa.


</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Females"/>
    <ns1:location rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Imperial Surveillance Outpost</ns1:location>
