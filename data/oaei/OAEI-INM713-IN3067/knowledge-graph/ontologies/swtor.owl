    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sand People</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageExternalLink rdf:resource="http://swtor.wikia.com/wiki/Infinite_Empire"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-10-24_18-44-05-02.png"/>
    <ns1:homeworld rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tatooine"/>
