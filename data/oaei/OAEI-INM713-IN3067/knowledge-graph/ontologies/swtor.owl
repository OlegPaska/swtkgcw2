  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Constitution">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Core_Worlds"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Gadon.jpg"/>
    <rdfs:comment xml:lang="en">The Galactic Constitution is the founding document and highest set of laws in the Galactic Republic. The Constitution was written in 25,053 BBY by a member of House Organa to unify the Core Worlds, and it is widely believed that the same Constitution existed throughout the Republic's existence; however, it certainly underwent drastic revisions and modifications at times (for example, the Ruusan Reformation). There is evidence that, as time went on, the Constitution was continually modified to grant more power to the central government.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Constitution</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Constitution</ns4:altLabel>
    <ns5:abstract xml:lang="en">The Galactic Constitution is the founding document and highest set of laws in the Galactic Republic. The Constitution was written in 25,053 BBY by a member of House Organa to unify the Core Worlds, and it is widely believed that the same Constitution existed throughout the Republic's existence; however, it certainly underwent drastic revisions and modifications at times (for example, the Ruusan Reformation). There is evidence that, as time went on, the Constitution was continually modified to grant more power to the central government.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Timeline"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/House_Organa"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Timeline"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Constitution</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ruusan_Reformation"/>
  </rdf:Description>
