    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mysterious box</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lieutenant_Muir.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic_items"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Dark_Side_Artifacts"/>
