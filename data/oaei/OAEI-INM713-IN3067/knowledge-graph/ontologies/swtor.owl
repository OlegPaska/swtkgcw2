    <ns1:title rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Convict</ns1:title>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mandalorians"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire_(New_Established_Sith_Empire)"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mandalorians"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Belsavis"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Humans"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Belsavis"/>
    <ns1:faction rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorians</ns1:faction>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Mandalorian_Clan_(Tatooine).jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Belsavis"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Convict</ns4:altLabel>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Male</ns1:gender>
    <ns5:abstract xml:lang="en">Mandalorian Convicts were Mandalorians taken prisoner after they destroyed a backwater planet by the Galactic Republic. However they broken free when riots started on Belsavis by the Sith Empire (New Established Sith Empire). They were armed with vibroswords.

</ns5:abstract>
