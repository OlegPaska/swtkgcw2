    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Smuggler</ns1:class>
    <ns5:abstract xml:lang="en">Exploits Upper Hand to fire a wave of bolts at the target, dealing 1997 - 2130 weapon damage. For each of your bleed effects present on the target, the target hemorrhages for an additional 854 internal damage. Requires and consumes Upper Hand.</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Wounding_Shots.png"/>
  </rdf:Description>
