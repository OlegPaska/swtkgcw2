  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kevin_Michael_Richardson">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kevin Michael Richardson</ns4:altLabel>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/wookieepedia"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Kevin_Michael_Richardson_FBoS_voice_actor_Cyrus.jpg"/>
    <ns5:abstract xml:lang="en">Kevin Michael Richardson provided the voice of Jace Malcom in the Hope and Return cinematics. He has provided numerous other voices in various other Star Wars media. 

</ns5:abstract>
    <rdfs:comment xml:lang="en">Kevin Michael Richardson provided the voice of Jace Malcom in the Hope and Return cinematics. He has provided numerous other voices in various other Star Wars media. 

