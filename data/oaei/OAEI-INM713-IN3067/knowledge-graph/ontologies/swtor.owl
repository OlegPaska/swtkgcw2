  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Recently_Infected">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recently Infected</ns4:altLabel>
    <ns5:abstract xml:lang="en">When attacking Rakghouls, you risk becoming recently infected, which will reduce your maximum health by 1%. To avoid this risk, you can purchase a vaccine from any medical droid. The vaccine will make you temporarily immune to becoming recently infected.</ns5:abstract>
    <rdfs:comment xml:lang="en">When attacking Rakghouls, you risk becoming recently infected, which will reduce your maximum health by 1%. To avoid this risk, you can purchase a vaccine from any medical droid. The vaccine will make you temporarily immune to becoming recently infected.</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Rebounding_Force.png"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Maximum health reduced by 1% per stack.</ns1:description>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Debuff</ns1:type>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recently Infected</rdfs:label>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recently Infected</ns1:name>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cabilities"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recently infected with Rakghoul Plague.</ns1:description>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recently Infected</ns5:wikiPageWikiLinkText>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kiffar">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Corso_riggs.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kiffar</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">Kiffar were a species of near-Humans from the planet Kiffu. Known members of the species were Shigar Konshi and Larin Moxla.

</rdfs:comment>
