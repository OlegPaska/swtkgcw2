  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/LucasArts">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Lucasarts_logo.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">LucasArts</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lucasarts</ns5:wikiPageWikiLinkText>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lraida.jpg"/>
    <ns5:abstract xml:lang="en">LucasArts Entertainment Company, LLC is an American video game publisher and licensor. Until 2013, it was also a video game developer. LucasArts is best known for its graphic adventure games, as well as games based on the Star Wars and Indiana Jones franchises. Its headquarters are in San Francisco, California. Paul Meegan is the current president of LucasArts. LucasArts is publishing Knights of the Old Republic and Knights of the Old Republic II


</ns5:abstract>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lucasarts_logo.png?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:LucasArts"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:LucasArts"/>
    <rdfs:comment xml:lang="en">LucasArts Entertainment Company, LLC is an American video game publisher and licensor. Until 2013, it was also a video game developer. LucasArts is best known for its graphic adventure games, as well as games based on the Star Wars and Indiana Jones franchises. Its headquarters are in San Francisco, California. Paul Meegan is the current president of LucasArts. LucasArts is publishing Knights of the Old Republic and Knights of the Old Republic II


</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">LucasArts</rdfs:label>
