  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Prolific_Justice">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesforce"/>
    <ns1:force rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:force>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shadow</ns1:class>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Prolific_Justice.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Prolific Justice</ns5:wikiPageWikiLinkText>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Prolific_Justice.png?width=300"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_In_Balance"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Prolific_Justice.PNG"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Prolific_Justice.PNG"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Prolific Justice</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Prolific Justice</ns4:altLabel>
    <ns1:description rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_In_Balance"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <rdfs:comment xml:lang="en">Force In Balance spreads your periodic Force Breach and Sever Force effects to the targets it damages, as long as it damages targets already affected by your Force Breach and Sever Force. In Addition, Force In Balance overwhelms its targets for 45 seconds. Overwhelmed targets take 10% more damage from area attacks.</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Prolific Justice</ns1:name>
    <ns5:abstract xml:lang="en">Force In Balance spreads your periodic Force Breach and Sever Force effects to the targets it damages, as long as it damages targets already affected by your Force Breach and Sever Force. In Addition, Force In Balance overwhelms its targets for 45 seconds. Overwhelmed targets take 10% more damage from area attacks.</ns5:abstract>
  </rdf:Description>
  <rdf:Description rdf:about="http://swtor.wikia.com/wiki/Special:FilePath/FreedonNaddTempleInterior.jpg">
    <ns2:rights rdf:resource="http://swtor.wikia.com/wiki/File:FreedonNaddTempleInterior.jpg"/>
    <ns3:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/FreedonNaddTempleInterior.jpg?width=300"/>
