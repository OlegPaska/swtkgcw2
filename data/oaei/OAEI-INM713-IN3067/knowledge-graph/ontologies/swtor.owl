    <ns1:channelingTime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:channelingTime>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Riposte.png?width=300"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slashes the target for 76-86 damage. Strikes with both weapons if dual wielding although with an accuracy and damage penalty.</ns1:description>
