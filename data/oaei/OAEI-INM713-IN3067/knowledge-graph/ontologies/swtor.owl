  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Ekkage">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Dark_Lords_of_the_Sith"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Persons_of_Note"/>
    <rdfs:comment xml:lang="en">Darth Ekkage was a female human Dark Lord of the Sith and Dark Councilor in the times of the Great Galactic War. She was the sister of Darth Baras and one of the greatest Sith assassins to have ever lived. Head of the Sphere of Mysteries, she was also in charge of the Red Legion, an Imperial unit of killers.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Lord_of_the_Sith"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
