  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Reminisce">
    <rdfs:comment xml:lang="en">Reminisce is a dialogue only Companion Mission for Vette that is available when you have enough affection points. During this dialogue Vette entertains the first notions of romance with the Sith Warrior. She comments on feeling funny about the Sith Warrior flirting with her friend Taunt during the earlier mission.</rdfs:comment>
    <ns1:prereqs rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Star_of_Ryloth"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:Reminisce</ns4:altLabel>
    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Vette"/>
    <ns1:rewards rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">+40 Affection</ns1:rewards>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Vette01.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Warrior"/>
    <ns1:prereqs rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?? Affection</ns1:prereqs>
    <ns5:abstract xml:lang="en">Reminisce is a dialogue only Companion Mission for Vette that is available when you have enough affection points. During this dialogue Vette entertains the first notions of romance with the Sith Warrior. She comments on feeling funny about the Sith Warrior flirting with her friend Taunt during the earlier mission.</ns5:abstract>
