  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Slash">
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Melee</ns1:type>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slash</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Slash.jpg"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesfocus"/>
    <rdfs:comment xml:lang="en">Slash is a starting ability for the Jedi Knight. It is the first ability to expend focus when used. It uses 3 focus, has a range of 4m and no cooldown or casting time.
</rdfs:comment>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slashes the target for 76-86 damage. Strikes with both weapons if dual wielding although with an accuracy and damage penalty.</ns1:description>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">4m</ns1:range>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Stubs"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Slash.jpg"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Slash.jpg?width=300"/>
    <ns1:focusUse rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ns1:focusUse>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Stubs"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slash</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">Slash is a starting ability for the Jedi Knight. It is the first ability to expend focus when used. It uses 3 focus, has a range of 4m and no cooldown or casting time.
</ns5:abstract>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Slash.jpg"/>
    <ns1:class rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slash</rdfs:label>
