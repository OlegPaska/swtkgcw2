  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Republic_War_Trust">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Project_Siantide"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Republic War Trust</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/RepublicEmblemTOR.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Vengean"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Warrior"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <rdfs:comment xml:lang="en">The Republic War Trust was the key 4 Republic general's, located on Taris, targeted by Darth Baras as part of Plan Zero, a plan designed by Darth Baras and his master, Darth Vengean to reignite the war between the Empire and Republic. As part of the Sith Warrior Storyline, the Sith Warrior is sent to Taris to destroy them. During the missions, the Sith Warrior discovers the Republic general's have been leading Project Siantide.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Baras"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Plan_Zero"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/pagename"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Warrior_Storyline"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Republic War Trust</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns5:abstract xml:lang="en">The Republic War Trust was the key 4 Republic general's, located on Taris, targeted by Darth Baras as part of Plan Zero, a plan designed by Darth Baras and his master, Darth Vengean to reignite the war between the Empire and Republic. As part of the Sith Warrior Storyline, the Sith Warrior is sent to Taris to destroy them. During the missions, the Sith Warrior discovers the Republic general's have been leading Project Siantide.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Republic War Trust</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Taris"/>
  </rdf:Description>
