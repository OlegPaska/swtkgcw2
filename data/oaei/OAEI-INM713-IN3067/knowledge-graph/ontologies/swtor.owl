    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Probe_Medic.png?width=300"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Increases the max number of Trauma Probes by [1 / 2 / 3], increases the healing each charge does by [5 / 10 / 15]% and reduces the rate limits Trauma Probe and Frontline Medic by [0.33 / 0.67 / 1] second each.</ns1:description>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
