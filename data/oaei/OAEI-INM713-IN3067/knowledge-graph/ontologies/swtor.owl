  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Emperor%27s_shuttle">
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire</ns1:allegiance>
    <ns1:passengers rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Imperial_Guard"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Emperor's shuttle</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Emperor%27s_power_base"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">shuttle</ns1:name>
    <ns1:passengers rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">&lt;ul type =</ns1:passengers>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/starship"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Emperor"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Emperor's shuttle</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">The Sith Emperor owns a Imperial Shuttle among the other space craft reserved for his use. When the Jedi Knight sought to confront the Emperor, the Knight and company stole The Emperor's shuttle from Kaas City so that they could get to the Dark Temple.


</rdfs:comment>
