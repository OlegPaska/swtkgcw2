  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Plunderer">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/npc"/>
    <ns5:abstract xml:lang="en">Mandalorian Plunderers were a unit of Mandalorian raiders that were under the command of Duran Gorr, assisting him in stealing Galactic Republic warheads on Taris. They were armed with Blaster Rifles.

</ns5:abstract>
