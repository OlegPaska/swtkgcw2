  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Potency">
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Potency</ns1:name>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Potency.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Potency</ns5:wikiPageWikiLinkText>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Potency</ns1:link>
    <ns1:activation rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:activation>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">90.0</ns1:cooldown>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:resource>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Potency</ns4:altLabel>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Ability Force Potency.png</ns1:icon>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Potency</rdfs:label>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Potency.png?width=300"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Grants 2 charges of Force Potency, which increases the Force critical chance of your direct attacks and heals by 60% and increases the range of Telekinetic Throw and Cascading Debris to 30 meters.  Each time a direct Force ability critically hits or each time a channeled Force ability is activated, 1 charge is consumed.  Lasts 20 seconds.</ns1:description>
  </rdf:Description>
