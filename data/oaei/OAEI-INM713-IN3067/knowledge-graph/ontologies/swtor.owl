  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Korriban_Arrival_Port">
    <ns1:caption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Map of Korriban Arrival Port</ns1:caption>
