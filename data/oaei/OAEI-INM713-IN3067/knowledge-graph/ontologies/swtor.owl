  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Progneitor">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Progneitor</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <rdfs:comment xml:lang="en">The Progneitor, known as the Giant Firaxan to those who did not know its true name, was the legendary mother of all life on Manaan, from the Firaxan sharks to the Selkath themselves. It was held with the highest respect by the Selkath, although they generally did not discuss it with outsiders.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Manaan"/>
