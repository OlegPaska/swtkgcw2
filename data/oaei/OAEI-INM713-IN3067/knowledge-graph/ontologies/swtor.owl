  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lightning_Strike">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning Strike</ns5:wikiPageWikiLinkText>
    <ns1:activation rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">2.0</ns1:activation>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning Strike</ns1:name>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/lightningstrike.png"/>
