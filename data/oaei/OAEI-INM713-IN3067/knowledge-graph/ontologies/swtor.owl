    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Onderon"/>
    <ns1:race rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Female</ns1:gender>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bakkel</rdfs:label>
    <rdfs:comment xml:lang="en">Bakkel was a female Beast Rider from Onderon. She was killed by the Jedi Exile in Iziz on Onderon while the Exile was seeking holodiscs for Dhagon Ghent. Bakkel refused to give the holodiscs to the Exile and became hostile forcing the Exile to kill her and her companions. She and her companions were often seen in the Beast Riders' Den in the Western Square's cantina.

</rdfs:comment>
