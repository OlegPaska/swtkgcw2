  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Trayus_Academy">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <rdfs:comment xml:lang="en">The Trayus Academy was an ancient Sith Academy located on the planet Malachor V prior to the planet's destruction.
It was the site of the defeat of the Sith Triumvirate and the deaths of the two surviving triumvirs, Darth Traya and Darth Sion, at the hands of the Jedi Exile and her companions.</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Triumvirate"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Traya"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Malachor_V"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Trayus Academy</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Malachor_V"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">secret academy</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Malachor_V"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Triumvirate"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Triumvirate"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/expand"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Trayusacademy.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Academy"/>
    <ns5:abstract xml:lang="en">The Trayus Academy was an ancient Sith Academy located on the planet Malachor V prior to the planet's destruction.
It was the site of the defeat of the Sith Triumvirate and the deaths of the two surviving triumvirs, Darth Traya and Darth Sion, at the hands of the Jedi Exile and her companions.</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Trayusacademy.jpg"/>
