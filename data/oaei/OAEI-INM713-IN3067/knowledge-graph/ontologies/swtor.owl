  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission_Vao">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Vulkar_swoop_gang"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic_characters"/>
    <ns5:abstract xml:lang="en">Mission Vao was a female Twi'lek street urchin from Taris who joined Revan in his quest for the Star Forge. She would later be known as one of the saviors of the galaxy and was awarded the Cross of Glory by the Republic.

</ns5:abstract>
