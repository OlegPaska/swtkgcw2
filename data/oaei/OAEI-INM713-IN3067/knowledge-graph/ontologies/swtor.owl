    <ns1:mission3difficultygreen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</ns1:mission3difficultygreen>
    <ns1:mission4description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">You received a holotransmission from a Rodian thief who broke into a high-security casino vault on Talravin, then accidentally locked himself inside. He'll share the wealth if rescued.</ns1:mission4description>
    <ns1:mission1difficultygreen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">125</ns1:mission1difficultygreen>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Treasure Hunting</rdfs:label>
    <ns1:mission4difficultygreen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</ns1:mission4difficultygreen>
