    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ord_Mantell"/>
    <rdfs:comment xml:lang="en">Clearing the Air is a mission that can be obtained at Level 1 by either the Smuggler or Trooper on Ord Mantell. The mission involves disabling three Signal Jammers so that Sergeant Blyes can reestablish contact with HQ.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions"/>
