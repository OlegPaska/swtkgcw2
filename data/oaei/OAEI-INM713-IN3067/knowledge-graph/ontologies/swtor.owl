  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant_Security">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Organizations"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Organizations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Captain_Winborn"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Migrant_Merchants%27_Guild"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sacking_of_Coruscant"/>
    <ns1:headquarters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Coruscant Security</rdfs:label>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Coruscant Security </ns5:wikiPageWikiLinkText>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Coruscant Security</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Republic"/>
    <ns5:abstract xml:lang="en">Coruscant Security, also known as Republic Security, was the police force on Coruscant. After the Sacking of Coruscant, Coruscant Security was overwhelmed by the chaos and rioting that erupted. The Republic government had little resources to offer and sectors fell under gang control. Though Coruscant Security has tried to retake those areas, many of its police officers have become embittered as instead of keeping the peace they are fighting a war on Coruscant's streets.

</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Corruptor_Zero.jpg"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/organisation"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Coruscant"/>
    <ns1:leader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Captain_Winborn"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Coruscant Security</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Senate"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Organizations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <rdfs:comment xml:lang="en">Coruscant Security, also known as Republic Security, was the police force on Coruscant. After the Sacking of Coruscant, Coruscant Security was overwhelmed by the chaos and rioting that erupted. The Republic government had little resources to offer and sectors fell under gang control. Though Coruscant Security has tried to retake those areas, many of its police officers have become embittered as instead of keeping the peace they are fighting a war on Coruscant's streets.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Sun"/>
