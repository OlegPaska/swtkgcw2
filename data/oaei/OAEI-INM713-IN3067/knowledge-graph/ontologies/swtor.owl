  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/History_of_Alderaan">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/quote"/>
    <ns5:abstract xml:lang="en">This lore can be found on Alderaan.
Republic: X: 1342, Y: 1792 It’s on the table next to General Linel Organa at Wardpost Luurdes in the King’s Pass area.
Empire: 697, -2639 On a table in Outpost Eudor, next to Doctor Drugindi

</ns5:abstract>
    <rdfs:comment xml:lang="en">This lore can be found on Alderaan.
Republic: X: 1342, Y: 1792 It’s on the table next to General Linel Organa at Wardpost Luurdes in the King’s Pass area.
Empire: 697, -2639 On a table in Outpost Eudor, next to Doctor Drugindi

</rdfs:comment>
