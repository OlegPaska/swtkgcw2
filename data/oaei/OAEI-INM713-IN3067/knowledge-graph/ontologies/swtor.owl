    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lord_Sharoleigh.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Recruitment"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lord Sharoleigh</ns5:wikiPageWikiLinkText>
