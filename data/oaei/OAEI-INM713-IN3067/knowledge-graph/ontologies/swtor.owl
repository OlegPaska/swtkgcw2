  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Trials">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight_(rank)"/>
    <ns5:abstract xml:lang="en">The Jedi Trials, also known as the Trials of Knighthood, Jedi rituals, or Jedi ceremonies, were the challenges by which Jedi Padawans were given as pre-requisites for achieving Knighthood, and were sometimes retaken by Knights to earn the rank of Jedi Master. The trials were administered by the Jedi High Council to any Padawan they deemed worthy of becoming a Jedi. The primary trials were a set of five, and were the Trial of Skill, the Trial of Courage, the Trial of the Flesh, the Trial of Spirit, and the Trial of Insight. In addition, the Council could assign substitute tests or use an exceptionally trying mission in place of the traditional tests. Like the Initiate Trials, these tests were required to be taken in order to proceed to the next rank in the Jedi Order.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Master"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Trials</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Trials</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sentinel_854x480.png"/>
    <rdfs:comment xml:lang="en">The Jedi Trials, also known as the Trials of Knighthood, Jedi rituals, or Jedi ceremonies, were the challenges by which Jedi Padawans were given as pre-requisites for achieving Knighthood, and were sometimes retaken by Knights to earn the rank of Jedi Master. The trials were administered by the Jedi High Council to any Padawan they deemed worthy of becoming a Jedi. The primary trials were a set of five, and were the Trial of Skill, the Trial of Courage, the Trial of the Flesh, the Trial of Spirit, and the Trial of Insight. In addition, the Council could assign substitute tests or use an exceptionally trying mission in place of the traditional tests. Like the Initiate Trials, these tests were required to be taken in order to proceed to the next rank in the Jedi Order.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Padawan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Trials</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">achieve</ns5:wikiPageWikiLinkText>
  </rdf:Description>
