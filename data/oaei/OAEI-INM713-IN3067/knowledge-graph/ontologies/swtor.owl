    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Var_Suthra"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Power Guard Enhancement System</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sadic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Shadow_Town"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Superweapons"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Potent_Medicine.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Blackstar_Squad"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <rdfs:comment xml:lang="en">The Power Guard Enhancement System was a scientific project overseen by the Galactic Republic during the Cold War against the Sith Empire. The project sought to use a combination of extensive cybernetic enhancements and adrenal stimulants to forge super-soldiers out of ordinary people. With the right procedures, being could be given more muscular strength, speed, and better fighting skills without extensive physical training or use of The Force.

</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Power Guard Enhancement System</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/General"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns5:abstract xml:lang="en">The Power Guard Enhancement System was a scientific project overseen by the Galactic Republic during the Cold War against the Sith Empire. The project sought to use a combination of extensive cybernetic enhancements and adrenal stimulants to forge super-soldiers out of ordinary people. With the right procedures, being could be given more muscular strength, speed, and better fighting skills without extensive physical training or use of The Force.

</ns5:abstract>
