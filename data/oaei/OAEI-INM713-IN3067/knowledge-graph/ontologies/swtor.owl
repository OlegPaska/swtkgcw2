  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Eternal_Empire_of_Zakuul">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Eternal Empire of Zakuul</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Zakuul"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Alliance_flag.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <rdfs:comment xml:lang="en">The Eternal Empire of Zakuul was a dictatorial government founded by Emperor Valkorion on the planet Zakuul sometime before the Galactic War of 3640 BBY. Valkorion used the Empire's large fleet to battle both the Galactic Republic and Sith Empire on multiple worlds, a war in which, he sought to reshape the entire galaxy.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Organizations"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Eternal Empire of Zakuul</ns5:wikiPageWikiLinkText>
