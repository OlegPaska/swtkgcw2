  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Duron_Qel-Droma">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Knights"/>
    <ns5:wikiPageExternalLink rdf:resource="http://swtor.wikia.com/wiki/Guun_Han_Saresh"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
