  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Most_Valuable_Player">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzones"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzones"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Mvp.png?width=300"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/expand"/>
    <rdfs:comment xml:lang="en">After each warzone, the players cast their vote for the Most Valuable Player or MVP. For each vote a player receives, an extra 50 Valor and 1 Warzone commendation is awarded. While each player can vote for a Most Valuable Player, it is in no way compulsory. The player can freely leave the warzone without giving a teammate his/her vote. The players cannot vote for themselves.</rdfs:comment>
    <ns5:abstract xml:lang="en">After each warzone, the players cast their vote for the Most Valuable Player or MVP. For each vote a player receives, an extra 50 Valor and 1 Warzone commendation is awarded. While each player can vote for a Most Valuable Player, it is in no way compulsory. The player can freely leave the warzone without giving a teammate his/her vote. The players cannot vote for themselves.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:PvP"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Most Valuable Player</ns5:wikiPageWikiLinkText>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Most Valuable Player</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Warzone_Commendation"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Most Valuable Player</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Mvp.png"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Mvp.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Valor"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:PvP"/>
  </rdf:Description>
