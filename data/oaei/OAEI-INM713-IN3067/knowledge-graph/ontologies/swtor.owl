  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Firewing">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bounty_Hunters"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bounty_Hunters"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bounty_Hunter"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Firewing.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/K-52_Strongarm"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Starfighter</ns1:type>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tyrant"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Firewing</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns1:length rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unknown</ns1:length>
    <rdfs:comment xml:lang="en">The Firewing was a K-52 Strongarm chosen for a special infiltration mission by a Bounty Hunter hired by Darth Tormen. The mission included smuggling the Hunter to the Valor-class cruiser Founder to kidnap Supreme Chancellor Dorian Janarus. Upon the Hunter's arrival in the Founders landing bay and the mission's completion, the Firewing was piloted back to Tormen's battle cruiser Tyrant.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Founder"/>
    <ns5:abstract xml:lang="en">The Firewing was a K-52 Strongarm chosen for a special infiltration mission by a Bounty Hunter hired by Darth Tormen. The mission included smuggling the Hunter to the Valor-class cruiser Founder to kidnap Supreme Chancellor Dorian Janarus. Upon the Hunter's arrival in the Founders landing bay and the mission's completion, the Firewing was piloted back to Tormen's battle cruiser Tyrant.

</ns5:abstract>
