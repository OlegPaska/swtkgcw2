    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ludo_Kressh"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">flagship</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ludo Kressh's flagship</rdfs:label>
    <ns1:length rdf:datatype="http://dbkwik.webdatacommons.org/datatype/metre">215.0</ns1:length>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Ludo_Kressh%27s_flagship.png"/>
    <rdfs:comment xml:lang="en">Ludo Kressh's flagship was a Derriphan-class battleship under the control of Sith Lord Ludo Kressh during the Great Hyperspace War. It was one of the few ships in Kressh's fleet which emerged unscathed from the Battle of Khar Delba, it was later destroyed when Kressh faked his death.


</rdfs:comment>
