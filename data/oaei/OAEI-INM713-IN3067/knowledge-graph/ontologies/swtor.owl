    <ns1:mission3time rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:mission3time>
    <ns1:mission3name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death of a Senator</ns1:mission3name>
    <ns1:mission2description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">A Republic Senator is assembling a team to track the expansion of the Black Sun gang and determine its links with other syndicates. Have your companion join up.</ns1:mission2description>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Crew_Skills"/>
    <ns5:abstract xml:lang="en">Investigation is one of the four Mission Skills. It involves the skill of examining evidence and following clues to discover valuable secrets.

</ns5:abstract>
