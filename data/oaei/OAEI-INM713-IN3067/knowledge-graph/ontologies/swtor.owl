    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian"/>
    <rdfs:comment xml:lang="en">Mandalorian Journeyman were a unit of Mandalorian mercenaries seen during the battle of Corellia, fighting for the Sith Empire (New Established Sith Empire). They were armed with Blaster Pistols.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Corellia"/>
    <ns1:title rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Journeyman</ns1:title>
