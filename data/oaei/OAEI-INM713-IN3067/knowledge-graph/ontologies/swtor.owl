    <ns1:next rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Desperate_Times"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Smugglers_Story_Missions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Smuggler"/>
    <ns1:end rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Corso Rigg</ns1:end>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ord_Mantell"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:level>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Skavak"/>
    <ns1:credits rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:credits>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Landing Party</ns4:altLabel>
    <ns1:rewards rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:rewards>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Smugglers_Story_Missions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Separatist_Movement"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ord_Mantell_Missions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Smugglers"/>
    <rdfs:comment xml:lang="en">Landing Party is the first mission in the Smuggler's story arc. The Smuggler will gain this mission automatically after disembarking their ship and talking with Skavak and later, Corso Riggs. The Smuggler must disable the Separatists' remote control stations for the defense gun so that the Smuggler can take-off again.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Drelliad"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SS_Jedi_Ship01_full.jpg"/>
