  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Iktotch_system">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Species"/>
    <ns5:abstract xml:lang="en">The Iktoch system included the planet of Iktotchon and the moon of Iktotch, which was the home to the Iktotchi species. With many plants, it had an environment powerful enough to withstand a fire.</ns5:abstract>
