  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hold-out_pistol">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blasters"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blasters"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hold-out pistol</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Blaster_Pistol"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blaster_pistols"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blaster_pistols"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/High_Impact_Bolt.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hold-out pistol</ns4:altLabel>
    <rdfs:comment xml:lang="en">A hold-out pistol was a tiny blaster pistol used as a backup for a main weapon or a surprise weapon. It was small enough to be easily concealed in either the character's clothing or their hand, and packed enough of a punch to deal with immediate threats.

</rdfs:comment>
    <ns5:abstract xml:lang="en">A hold-out pistol was a tiny blaster pistol used as a backup for a main weapon or a surprise weapon. It was small enough to be easily concealed in either the character's clothing or their hand, and packed enough of a punch to deal with immediate threats.

</ns5:abstract>
