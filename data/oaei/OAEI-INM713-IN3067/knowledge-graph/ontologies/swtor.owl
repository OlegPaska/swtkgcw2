    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-11-05_21-23-16-89.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galaxy"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/TOR_Timeline010.jpg"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Green Jedi</ns4:altLabel>
    <ns5:abstract xml:lang="en">The Green Jedi are a group of force users that swear fealty to the flag of Corellia over the rest of the Galaxy. These Jedi are often treated with suspicion, they operate from their enclave attacking and hampering the Imperial war effort.

</ns5:abstract>
    <rdfs:comment xml:lang="en">The Green Jedi are a group of force users that swear fealty to the flag of Corellia over the rest of the Galaxy. These Jedi are often treated with suspicion, they operate from their enclave attacking and hampering the Imperial war effort.

</rdfs:comment>
