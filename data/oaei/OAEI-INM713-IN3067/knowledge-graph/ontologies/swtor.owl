  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Zeltron">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Zeltron</ns4:altLabel>
    <rdfs:comment xml:lang="en">Zeltrons were a near-human species from the planet Zeltros. While often written off as simple hedonists by the majority of the galaxy, Zeltrons made formidable warriors when they chose to be.
A former high-ranking member of the Exchange crime syndicate Luxa was Zeltron.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Crime_Syndicate"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Zeltron</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Exchange"/>
