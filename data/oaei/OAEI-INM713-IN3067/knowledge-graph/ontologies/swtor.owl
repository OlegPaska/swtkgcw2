  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kinetic_Ward">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath///swtorunlimited.com/wp-content/uploads/2011/04/db_kinetic.png"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath///swtorunlimited.com/wp-content/uploads/2011/04/db_kinetic.png?width=300"/>
    <ns5:wikiPageExternalLink rdf:resource="http://swtorunlimited.com/wp-content/uploads/2011/04/db_kinetic.png"/>
    <ns5:abstract xml:lang="en">A skill on the Jedi skill trees. This defensive skill uses 10 Force points, has an instant cast effect, and a 12 second cooldown period. The skill creates a shield with 8 charges that increase the chances for an existing kinetic defense to block an attack by 15% for 20 seconds. Each time the block is effective, the ward loses 1 charge, but using the skill does not break Stealth effects. [1]</ns5:abstract>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kinetic Ward</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Force_powers"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kinetic Ward</rdfs:label>
    <rdfs:comment xml:lang="en">A skill on the Jedi skill trees. This defensive skill uses 10 Force points, has an instant cast effect, and a 12 second cooldown period. The skill creates a shield with 8 charges that increase the chances for an existing kinetic defense to block an attack by 15% for 20 seconds. Each time the block is effective, the ward loses 1 charge, but using the skill does not break Stealth effects. [1]</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Force_powers"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://swtor.wikia.com/wiki/Special:FilePath/The_Flame_2.jpg">
    <ns2:rights rdf:resource="http://swtor.wikia.com/wiki/File:The_Flame_2.jpg"/>
