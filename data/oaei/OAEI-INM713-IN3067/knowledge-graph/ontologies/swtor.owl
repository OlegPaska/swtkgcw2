  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Balmorran_Corporations">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Balmorran Corporations</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Balmorra"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Balmorra"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Balmorran Corporations</rdfs:label>
    <ns5:abstract xml:lang="en">This lore can be found on Balmorra.
Republic: X:-928, Y:1528 Balmorra Corporations Lore object is located in the Heroic Area, Okara Droid Factory, Assembly Line. 
Empire: X:-929, Y:1528 The confusing part is there are technically two locations within the Droid Factory. One is downstairs on the bridges, and the correct one where the Lore is located, is on the main level of “Assembly Line” on the opposite side from where you enter the area. 

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Balmorra-balmorran-arms-factory-republic.jpg"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Balmorran Corporations</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">This lore can be found on Balmorra.
Republic: X:-928, Y:1528 Balmorra Corporations Lore object is located in the Heroic Area, Okara Droid Factory, Assembly Line. 
Empire: X:-929, Y:1528 The confusing part is there are technically two locations within the Droid Factory. One is downstairs on the bridges, and the correct one where the Lore is located, is on the main level of “Assembly Line” on the opposite side from where you enter the area. 

</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_governor">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith governor</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_trooper"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_grenadier"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/List_of_KotOR_equipment#Sith_Launch_Codes"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith governor</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/CA_20090102_SithGarment_full.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_squad_leader"/>
    <ns5:abstract xml:lang="en">The Sith governor was a Sith who was put in charge of a planet. The governors were often Force-users who were placed in charge of several apprentices and the Sith troops on planet. They generally specialized in melee combat, and most aspired to impress their superiors enough to prove themselves worthy of bearing a lightsaber.
Revan killed the Sith governor on Taris in order to acquire the launch codes that allowed him to leave the planet.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith governor</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_positions"/>
    <rdfs:comment xml:lang="en">The Sith governor was a Sith who was put in charge of a planet. The governors were often Force-users who were placed in charge of several apprentices and the Sith troops on planet. They generally specialized in melee combat, and most aspired to impress their superiors enough to prove themselves worthy of bearing a lightsaber.
Revan killed the Sith governor on Taris in order to acquire the launch codes that allowed him to leave the planet.

</rdfs:comment>
