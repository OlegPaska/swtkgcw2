  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cay_Qel-Droma">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lien-Tsai_Qel-Droma"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Male</ns1:gender>
    <rdfs:comment xml:lang="en">{{ #if: |
Cay Qel-Droma was a Human male Jedi Knight. He was the son of Jedi Master Lien-Tsai Qel-Droma, the younger brother of former Jedi Knight/Dark Lord of the Sith Ulic Qel-Droma, and the cousin of Jedi Knight Duron Qel-Droma.
During the Freedon Nadd Uprising, Cay lost his left arm. He replaced with an arm he salvaged from a droid.
</rdfs:comment>
    <ns1:faction rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Order</ns1:faction>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/character"/>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cay Qel-Droma</ns5:wikiPageWikiLinkText>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Alderaan"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cay Qel-Droma</ns4:altLabel>
