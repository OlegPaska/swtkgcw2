  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Standard_Calendar">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ruusan_Reformation"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Placeholder"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Civil_War"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Standard Calendar</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageExternalLink rdf:resource="http://starwars.wikia.com/wiki/Galactic_Standard_Calendar"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Timeline"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Hyperspace_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Treaty_of_Coruscant"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Timeline"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Wars"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gnost-Dural"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Galactic Standard Calendar</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Calendar"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hundred-Year_Darkness"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/GrandConvocationChamber-TOR.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Sith_War"/>
    <ns5:abstract xml:lang="en">The Galactic Standard Calendar was the standard measurement of time in the galaxy. It centered around the Coruscant solar cycle, which was 368 days long with a day consisting of 24 standard hours. Numerous epochs were used to determine calendar eras. The most recent of these calendar eras used the Battle of Yavin as its epoch, or "year zero." BBY stands for Before the Battle of Yavin and ABY stands for After the Battle of Yavin.

</ns5:abstract>
    <rdfs:comment xml:lang="en">The Galactic Standard Calendar was the standard measurement of time in the galaxy. It centered around the Coruscant solar cycle, which was 368 days long with a day consisting of 24 standard hours. Numerous epochs were used to determine calendar eras. The most recent of these calendar eras used the Battle of Yavin as its epoch, or "year zero." BBY stands for Before the Battle of Yavin and ABY stands for After the Battle of Yavin.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
  </rdf:Description>
