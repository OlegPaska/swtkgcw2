  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Welcome_Jaesa_Willsaam">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Vette"/>
    <ns1:repeatable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">No</ns1:repeatable>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:Welcome Jaesa Willsaam</ns4:altLabel>
    <ns1:credits rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:credits>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Companion</ns1:type>
    <ns1:rewards rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:rewards>
    <ns1:start rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jaesa_Willsaam"/>
    <ns1:caption rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jaesa_Willsaam"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jaesa_Willsaam"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Jaesa.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Companion_Missions"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Jaesa.jpg"/>
    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jaesa_Willsaam"/>
    <ns1:prereqs rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Acquired as companion</ns1:prereqs>
    <rdfs:comment xml:lang="en">Welcome Jaesa Willsaam is the initial, dialogue only, Companion Mission for Jaesa that is available upon first acquiring her as a companion.
If you have acquired Jaesa with her Dark Side personality, she will discuss he initial feelings of giving over to the Dark Side. She seems to have adapted very quickly to her new situation. Depending on dialog choices she may also bring up concern over Vette's trustworthiness, seeing that Vette does not appear to have Dark Side inclinations.</rdfs:comment>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Welcome Jaesa Willsaam</ns1:name>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/quest"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns5:abstract xml:lang="en">Welcome Jaesa Willsaam is the initial, dialogue only, Companion Mission for Jaesa that is available upon first acquiring her as a companion.
If you have acquired Jaesa with her Dark Side personality, she will discuss he initial feelings of giving over to the Dark Side. She seems to have adapted very quickly to her new situation. Depending on dialog choices she may also bring up concern over Vette's trustworthiness, seeing that Vette does not appear to have Dark Side inclinations.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:Welcome Jaesa Willsaam</rdfs:label>
  </rdf:Description>
