  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/King">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">King</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">king</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">monarch</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">A King is the male head of a monarchic government. The female equivalent is the queen. Several governments in the galaxy has kings. One of the leaders of the Zeltron species possessed the title of King. The King of the Sith species is also known as the Sith'ari. Before the establishment of a theocracy on Nazzri in 5,002 BBY, the Nazzar are ruled by figure with the double title of emperor-king. Thereafter the planetary ruler was merely entitled king.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">King</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galaxy_Map"/>
    <rdfs:comment xml:lang="en">A King is the male head of a monarchic government. The female equivalent is the queen. Several governments in the galaxy has kings. One of the leaders of the Zeltron species possessed the title of King. The King of the Sith species is also known as the Sith'ari. Before the establishment of a theocracy on Nazzri in 5,002 BBY, the Nazzar are ruled by figure with the double title of emperor-king. Thereafter the planetary ruler was merely entitled king.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">King</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath///swtorunlimited.com/wp-content/uploads/2011/04/db_kinetic.png"/>
  </rdf:Description>
