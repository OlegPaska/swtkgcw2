    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Knights of the Old Republic II: The Sith Lords</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Star Wars - Knights of The Old Republic II The Sith Lords</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nar_Shaddaa"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords"/>
    <ns1:timeline rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298</ns1:timeline>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SWTOR_Encyclopedia.jpg"/>
    <ns1:genre rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">RPG</ns1:genre>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lonna_Vash"/>
