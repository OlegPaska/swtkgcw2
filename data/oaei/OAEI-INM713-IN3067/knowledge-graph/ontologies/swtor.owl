  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kinetic_Damage">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-10-19_14-34-39-72.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Armor_Rating_(Character)"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kinetic Damage</ns4:altLabel>
    <ns5:abstract xml:lang="en">Kinetic Damage is one of four Damage Types found in Star Wars: The Old Republic. Kinetic Damage refers to any damage that is based around the Force or abilities that may have an explosion effect like grenades. Kinetic Damage is also generated from attacks using Vibro weapons, such as Vibroknife and Vibroswords.  Kinetic Damage, along with Energy Damage, is mitigated by Armor Rating.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kinetic Damage</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Damage_Types"/>
    <rdfs:comment xml:lang="en">Kinetic Damage is one of four Damage Types found in Star Wars: The Old Republic. Kinetic Damage refers to any damage that is based around the Force or abilities that may have an explosion effect like grenades. Kinetic Damage is also generated from attacks using Vibro weapons, such as Vibroknife and Vibroswords.  Kinetic Damage, along with Energy Damage, is mitigated by Armor Rating.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Damage_Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Energy_Damage"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kinetic Damage</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Damage_Type"/>
  </rdf:Description>
