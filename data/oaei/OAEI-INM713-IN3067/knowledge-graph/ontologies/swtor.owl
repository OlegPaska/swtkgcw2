  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Belsavis">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/CA_20100312_Belsavis01_full.jpg"/>
