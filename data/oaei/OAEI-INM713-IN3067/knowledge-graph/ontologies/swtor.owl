    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Overclock</ns5:wikiPageWikiLinkText>
