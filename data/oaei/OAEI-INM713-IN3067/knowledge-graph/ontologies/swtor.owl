    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ironsights</ns4:altLabel>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Increases the damage dealt by grenade attacks, round attacks, and Vortex Bolt by 10%.  Additionally, Vortex Bolt marks its target.  Marked targets take 5% more damage from ranged attacks.</ns1:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Code">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
