    <ns1:cstyle rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_vision"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Zayne Carrick</ns1:name>
