  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Czerka_VX-736_Injector">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tatooine"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Items"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Items"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Czerka_Logo.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Czerka_Corporation"/>
    <rdfs:comment xml:lang="en">The Czerka VX-736 Injector vaccine was created by Czerka Corporation and is generally available where Czerka Corp has a significant presence. Since it vaccinates against Womp Rat Fever, its particularly useful on Tatooine.
Note that the vaccine appears to last a very long 8 hours.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Womp_Rat_Fever"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Czerka VX-736 Injector</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tatooine"/>
    <ns5:abstract xml:lang="en">The Czerka VX-736 Injector vaccine was created by Czerka Corporation and is generally available where Czerka Corp has a significant presence. Since it vaccinates against Womp Rat Fever, its particularly useful on Tatooine.
Note that the vaccine appears to last a very long 8 hours.</ns5:abstract>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cost"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Czerka VX-736 Injector</ns4:altLabel>
