  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/K%27lor%27slug">
    <ns1:playable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">No</ns1:playable>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/K%27lor%27slug.jpg?width=300"/>
    <rdfs:comment xml:lang="en">The K'lor'slug is a large worm-like creature that possesses a serpentine body propelled by many dangerously-edged legs. The mouth is a gaping circular maw filled with lamprey-like concentric rings of teeth.There are a few variations: the Greater K'lor'slug (pictured) and the Lesser K'lor'slug (also noted as Burrowers, Foragers, and Broodlings).

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Creature_Companion"/>
