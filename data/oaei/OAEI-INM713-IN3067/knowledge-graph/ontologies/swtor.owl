  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sniper_Rifle">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Imperial_Agents"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sniperrifleguide.jpg?width=300"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sniper Rifle</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Snipers"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:SniperRifleConcepts.jpg"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SniperRifleConcepts.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sniper Rifle</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cover"/>
    <ns5:abstract xml:lang="en">The Sniper rifle is a high powered long range weapon that deals incredible damage over a long distances allowing the Imperial Agent code name Cipher 9 to kill his targets from a safe distance keeping out of harms way.
The Sniper Rifles abilities do not work well in close distance as being a Sniper you are to stay away from the combat and provide support to the Imperial army if possible. 
When a Sniper is in cover he pulls up a personal shield that protects from most damage but doesn't make him invulerable.This weapon can be deadly in the hands of a highly trained Sniper.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sniper"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blasters"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blasters"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Imperial_Agents"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SniperRifleConcepts.jpg?width=300"/>
    <ns5:wikiPageExternalLink rdf:resource="http://www.swtor.com/community/showthread.php?t=45203&amp;page=2"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sniperrifleguide.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sniper Rifle</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Snipers"/>
    <rdfs:comment xml:lang="en">The Sniper rifle is a high powered long range weapon that deals incredible damage over a long distances allowing the Imperial Agent code name Cipher 9 to kill his targets from a safe distance keeping out of harms way.
The Sniper Rifles abilities do not work well in close distance as being a Sniper you are to stay away from the combat and provide support to the Imperial army if possible. 
When a Sniper is in cover he pulls up a personal shield that protects from most damage but doesn't make him invulerable.This weapon can be deadly in the hands of a highly trained Sniper.

</rdfs:comment>
