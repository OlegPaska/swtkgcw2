  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Rwookrrorro">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rwookrrorro</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_sublevels"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kashyyyk"/>
    <ns5:abstract xml:lang="en">Rwookrrorro was a large Wookiee village on Kashyyyk. It was the home of Zaalbar and his family, as well as the home of the leader of the Wookiees at the time of the Jedi Civil War.


</ns5:abstract>
