  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:The_Face_Merchants">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">[HEROIC 2+] The Face Merchants</ns5:wikiPageWikiLinkText>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">[HEROIC 2+] The Face Merchants</ns1:name>
    <ns5:abstract xml:lang="en"> The Face Merchants is a level 11 heroic mission available to all Republic classes on Coruscant.

</ns5:abstract>
    <ns1:prereqs rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">At lest level 6</ns1:prereqs>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Maxresdefault2.jpg?width=300"/>
    <ns1:experience rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">+1840</ns1:experience>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:The Face Merchants</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:The Face Merchants</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Maxresdefault2.jpg"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/quest"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</ns1:level>
    <ns1:start rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Security_Officer_Stansun"/>
    <ns1:repeatable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Yes</ns1:repeatable>
    <rdfs:comment xml:lang="en"> The Face Merchants is a level 11 heroic mission available to all Republic classes on Coruscant.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Security_Officer_Stansun"/>
    <ns1:caption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The surgery droids being controlled by the Black Sun are the mission's main goal.</ns1:caption>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Security_Officer_Stansun"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Heroic</ns1:type>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ieldis">
