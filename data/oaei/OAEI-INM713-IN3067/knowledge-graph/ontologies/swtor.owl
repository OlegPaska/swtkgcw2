    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Grav Round</ns1:link>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fires a round that creates a gravity vortex on the target, dealing 1916-2043 kinetic damage, crushing the target's armor and reducing armor rating by 20% for 45 seconds.  Gravity vortices leave targets vulnerable to High Impact Bolt and increases the damage they take from Demolition Round for 45 seconds.</ns1:description>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Grav_Round_Commando.png"/>
