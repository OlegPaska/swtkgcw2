    <ns1:playable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">No</ns1:playable>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Zeltron_Female.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Luxa"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Zeltros"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Zeltron_Female.jpg"/>
    <ns5:abstract xml:lang="en">Zeltrons were a near-human species from the planet Zeltros. While often written off as simple hedonists by the majority of the galaxy, Zeltrons made formidable warriors when they chose to be.
A former high-ranking member of the Exchange crime syndicate Luxa was Zeltron.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Zeltron_Female.jpg"/>
