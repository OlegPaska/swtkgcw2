  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jasshi%27rr">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ceremonies"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Jarg.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ceremonies"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jasshi'rr</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jasshi'rr</ns4:altLabel>
    <rdfs:comment xml:lang="en">Jasshi'rr is the name of the ancient Twi'lek marriage ceremony. Tales stated that the ceremony was presided over by a crystal skull carved from the crystallized ashes of a fallen Twi'lek hero.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Twi%27lek"/>
    <ns5:abstract xml:lang="en">Jasshi'rr is the name of the ancient Twi'lek marriage ceremony. Tales stated that the ceremony was presided over by a crystal skull carved from the crystallized ashes of a fallen Twi'lek hero.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jasshi'rr</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Weaken_Mind">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Weaken Mind</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Sage"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Weaken Mind</rdfs:label>
    <rdfs:comment xml:lang="en">Weaken Mind is an ability available to the Jedi Sage at level 16. It requires 17.5 force to cast, range of 30m and is instant cast. It deals damage over time (DOT). It is one of the primary abilities of a Jedi Sage who is specced into Telekentics.

</rdfs:comment>
    <ns5:abstract xml:lang="en">Weaken Mind is an ability available to the Jedi Sage at level 16. It requires 17.5 force to cast, range of 30m and is instant cast. It deals damage over time (DOT). It is one of the primary abilities of a Jedi Sage who is specced into Telekentics.

</ns5:abstract>
