    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cabilities"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bore</ns4:altLabel>
