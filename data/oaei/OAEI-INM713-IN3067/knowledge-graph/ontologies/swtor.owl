  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Characters">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Characters</rdfs:label>
    <ns4:broader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns4:prefLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Characters</ns4:prefLabel>
