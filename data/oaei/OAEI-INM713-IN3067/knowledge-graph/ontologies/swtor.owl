  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Special_Munitions">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesammo"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">ncreases the effect of your cells while they are active:
Plasma Cell: Increases ranged critical chance by [2 / 4 / 6]%.
Armor Piercing Cell: Reduces the cost of High Impact Bolt by [3 / 6 / 9] and Grav Round by [1 / 2 / 3].
Combat Support Cell: Increases tech critical chance by [1 / 2 / 3]%.</ns1:description>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Special Munitions</ns5:wikiPageWikiLinkText>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Special_Munitions.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Special_Munitions.PNG"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Special Munitions</rdfs:label>
    <ns1:cells rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cells>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Special_Munitions.png"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Special Munitions</ns1:name>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Commando</ns1:class>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Special Munitions</ns4:altLabel>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Special_Munitions.PNG"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <rdfs:comment xml:lang="en">Increases the effect of your cells while they are active:Plasma Cell: Increases ranged critical chance by 2%.Armor Piercing Cell: Reduces the cost of High Impact Bolt by 3 and Grav Round by 1.Combat Support Cell: Increases tech critical chance by 1%.

</rdfs:comment>
