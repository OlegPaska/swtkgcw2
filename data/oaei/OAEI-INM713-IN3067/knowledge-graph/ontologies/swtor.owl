  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Slippery_Devil">
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Slippery_Devil.PNG"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slippery Devil</rdfs:label>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Scoundrel</ns1:class>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slippery Devil</ns4:altLabel>
    <ns1:energy rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:energy>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slippery Devil</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">Increases your effective stealth level by 1. In addition, when you activate Scamper you gain a 25% chance to dodge all incoming attacks for 1 second. This effect cannot occur for more than 15 seconds, additionally reduces the energy cost of scamper by 2.

</ns5:abstract>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Slippery_Devil.PNG"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesenergy"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Slippery_Devil.png"/>
    <rdfs:comment xml:lang="en">Increases your effective stealth level by 1. In addition, when you activate Scamper you gain a 25% chance to dodge all incoming attacks for 1 second. This effect cannot occur for more than 15 seconds, additionally reduces the energy cost of scamper by 2.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:description rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">15.0</ns1:description>
