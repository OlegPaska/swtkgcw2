    <ns1:next rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:next>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:World_Arc_Missions"/>
    <ns1:prereqs rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:prereqs>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Journey into Dust</ns5:wikiPageWikiLinkText>
    <ns1:rewards rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:rewards>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tatooine"/>
    <ns1:start rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:start>
    <ns1:end rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Captain Golah</ns1:end>
    <ns5:abstract xml:lang="en">Journey into Dust is a quest that occurs on Tatooine. It is given to an Sith Empire Player around level 25 or 26. It involves killing numerous Sand People to finally find a mural that will lead the player to a Czerka research facility. It is unknown who the quest is given by.

</ns5:abstract>
