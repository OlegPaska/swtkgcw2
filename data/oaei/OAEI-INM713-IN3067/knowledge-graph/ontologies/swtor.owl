  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tara_Strong">
    <rdfs:comment xml:lang="en">Tara Lyn (Charendoff) Strong (born February 12, 1973) is a Canadian actress and singer. She has done voice work in numerous animated films, television series, and video games. Her voice roles include Harley Quinn from Batman: Arkham, Dil Pickles from Rugrats and All Grown Up!, Bubbles from The Powerpuff Girls, Timmy Turner and Poof from The Fairly OddParents, Raven from Teen Titans and Teen Titans Go!, Ben Tennyson from Ben 10, Princess Clara and Toot Braunstein from Drawn Together, and Twilight Sparkle from My Little Pony: Friendship Is Magic.
</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Tara_Strong_Portrait.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Risha"/>
