  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Seethe">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Seethe.png"/>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">none</ns1:cooldown>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Seethe</ns5:wikiPageWikiLinkText>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Seethe.png"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pause to prepare for the upcoming fight, restores health and force. Damage causes the effect to end prematurely. Cannot be used in combat.</ns1:description>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Self</ns1:range>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Seethe.png"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability_tooltip"/>
    <ns1:force rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">none</ns1:force>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Seethe</rdfs:label>
    <ns1:class rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Inquisitor"/>
    <ns5:abstract xml:lang="en">[[File:.png|16px]] [[|]]
Seethe is a starting ability for the Sith Inquisitor. It allows the Inquisitor to restore health and force over 15 seconds. It channels for 15 seconds and does not have a cooldown.

</ns5:abstract>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Seethe</ns4:altLabel>
    <rdfs:comment xml:lang="en">[[File:.png|16px]] [[|]]
Seethe is a starting ability for the Sith Inquisitor. It allows the Inquisitor to restore health and force over 15 seconds. It channels for 15 seconds and does not have a cooldown.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Inquisitor"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Heal</ns1:type>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Seethe.png?width=300"/>
    <ns1:ctime rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">15.0</ns1:ctime>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ability:Backlash">
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Backlash</ns4:altLabel>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Backlash.png?width=300"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Backlash</rdfs:label>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Backlash</ns1:link>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Backlash.png"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Static Barriers you place on yourself erupt in a flash of light when they end, blinding up to 8 nearby enemies for 3 seconds.  This effect breaks from direct damage.</ns1:description>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Backlash</ns1:name>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Ability Backlash.png</ns1:icon>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Utility</ns1:role>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/303_BTC">
    <ns1:events rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Civil_War"/>
