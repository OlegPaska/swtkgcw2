  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Homegrown_Pharmacology">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Homegrown Pharmacology</ns4:altLabel>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Homegrown Pharmacology</ns1:name>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Homegrown_Pharmacology.png?width=300"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Increases the healing dealt by periodic effects by 3%.  In addition, the energy cost of Kolto Cloud is reduced by 5, and targets affected by Kolto Cloud are invigorated for 45 seconds.  Invigorated targets receive 3% more healing from all sources.</ns1:description>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Homegrown_Pharmacology.png"/>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Homegrown_Pharmacology.PNG</ns1:icon>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Homegrown Pharmacology</rdfs:label>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Homegrown Pharmacology</ns1:link>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Homegrown Pharmacology</ns5:wikiPageWikiLinkText>
  </rdf:Description>
