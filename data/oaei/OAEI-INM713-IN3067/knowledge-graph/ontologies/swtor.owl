  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Flashpoint_Couriers">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Flashpoints"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Flashpoint Couriers</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Flashpoint Couriers</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Flashpoint"/>
    <ns5:abstract xml:lang="en">A flashpoint courier is an NPC that will offer a mission that will eventually lead into a flashpoint. This is sometimes the only way to accept flashpoint missions other than accepting a queue from the group finder or going to your fleet and finding the misison offer among the docked ships.
On planets where these beings offer the mission, there is normally a transport shuttle next to it that will take the player up to their respective fleet. The shuttle will not take the player right to the main section of the fleet, but will take players directly to the flashpoint or to the area of the fleet where the flashpoint begins. </ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/02priority_transport_officer.jpg"/>
    <rdfs:comment xml:lang="en">A flashpoint courier is an NPC that will offer a mission that will eventually lead into a flashpoint. This is sometimes the only way to accept flashpoint missions other than accepting a queue from the group finder or going to your fleet and finding the misison offer among the docked ships.
</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Flashpoints"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/02priority_transport_officer.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/NPC"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:02priority_transport_officer.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
  </rdf:Description>
