  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Shii-cho_Form">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
    <ns5:abstract xml:lang="en">An extremely common lightsaber form used by new apprentices / padawans of the Sith Empire &amp; the Jedi Order. This form is an instant which decreases the damage you get by 3% and increases the damage you make by 3%. </ns5:abstract>
    <ns1:focusGain rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:focusGain>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Melee</ns1:type>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shii-Cho Form</ns5:wikiPageWikiLinkText>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shii-cho Form</rdfs:label>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Knight / Sith Warrior</ns1:class>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shii-cho Form</ns4:altLabel>
    <rdfs:comment xml:lang="en">An extremely common lightsaber form used by new apprentices / padawans of the Sith Empire &amp; the Jedi Order. This form is an instant which decreases the damage you get by 3% and increases the damage you make by 3%. </rdfs:comment>
