  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Enclave_(Tython)">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:abstract xml:lang="en">The Masters' Retreat was an enclave maintained on the planet Tython after the Jedi Order relocated to their original homeworld following the destruction of the Coruscant Jedi Temple and the Galactic Republic's defeat in the Great Galactic War at the hands of the Sith Empire.</ns5:abstract>
