    <ns1:mission9name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Visualization Empire</ns1:mission9name>
    <ns1:mission8description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Exchange recently made a fortune investing in several cutting-edge tech corporations. Send your companion to figure out how they've been so successful.</ns1:mission8description>
