  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jukebox">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Rest_Zone"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Rest_Zone"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jukebox</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jukebox_Token"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Slippery_Slopes_Cantina"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1020.jpg?width=300"/>
    <ns5:abstract xml:lang="en">A jukebox is an instrument usually located in a cantina such as the Slippery Slopes Cantina in Nar Shadaa. A jukebox plays  music in the cantina for relaxation and a Jukebox Token can be acquired from a Cantina Vendor usually for 100 Galactic Credits. With the token a player can listen to the song of his/her choice for a limited amount of time. After the time runs out a player must buy another jukebox token, or the jukebox will play a random song in its databank.
</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1020.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Vendors"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Cantina"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jukebox</ns4:altLabel>
    <rdfs:comment xml:lang="en">A jukebox is an instrument usually located in a cantina such as the Slippery Slopes Cantina in Nar Shadaa. A jukebox plays  music in the cantina for relaxation and a Jukebox Token can be acquired from a Cantina Vendor usually for 100 Galactic Credits. With the token a player can listen to the song of his/her choice for a limited amount of time. After the time runs out a player must buy another jukebox token, or the jukebox will play a random song in its databank.
</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Cantina"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jukebox</rdfs:label>
  </rdf:Description>
