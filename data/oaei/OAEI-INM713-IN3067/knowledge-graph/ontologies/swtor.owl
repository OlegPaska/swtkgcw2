  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Vulkar_swoop_gang">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Undercity"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gadon_Thek"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hidden_Bek_swoop_gang"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar</ns5:wikiPageWikiLinkText>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar swoop gang</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Brejik"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/wookieepedia"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lower_City"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Minor_Factions"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar swoop gang</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Taris"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Vulkar_Base"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Black_Talon.png"/>
    <rdfs:comment xml:lang="en">The Black Vulkar swoop gang, more commonly known as the Black Vulkars, or simply the Vulkars were a swoop gang on Taris. They were based in the Lower City, but occasionally went to the Undercity, for example when they searched the escape pods that crashed there and found Bastila Shan.
The Vulkars were led by Brejik, a former Hidden Bek, who left the Beks after the leader of the Hidden Beks, Gadon Thek was injured and blinded, yet retained his leadership over the gang. Brejik declared a gang war with the Beks, and the war was raging until Taris was bombed.


</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Escape_pod"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Minor_Factions"/>
    <ns5:abstract xml:lang="en">The Black Vulkar swoop gang, more commonly known as the Black Vulkars, or simply the Vulkars were a swoop gang on Taris. They were based in the Lower City, but occasionally went to the Undercity, for example when they searched the escape pods that crashed there and found Bastila Shan.
The Vulkars were led by Brejik, a former Hidden Bek, who left the Beks after the leader of the Hidden Beks, Gadon Thek was injured and blinded, yet retained his leadership over the gang. Brejik declared a gang war with the Beks, and the war was raging until Taris was bombed.


</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bastila_Shan"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkars</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar swoop gang</ns4:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/DN-314_Tunneler">
