  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Riposte">
    <ns5:abstract xml:lang="en">An ability gained at level 5 for a Jedi Knight, a standard melee technique.</ns5:abstract>
