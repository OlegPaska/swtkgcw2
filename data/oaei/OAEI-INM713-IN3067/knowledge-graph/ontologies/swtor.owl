    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Cdx.persons.warrior.the_entity.png"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Story_Missions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ranna_Tao%27Ven"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Knights"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Flesh_Raider"/>
    <rdfs:comment xml:lang="en">Master Orgus Din learned that the Flesh Raiders are using an energy shield to protect their camps. The shields are powered by a generator inside a heavily guarded cave deep inside Flesh Raider territory. Infiltrate the Flesh Raider cave and disable the energy shield control console so Master Orgus can strike at their camps.

</rdfs:comment>
