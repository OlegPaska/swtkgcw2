    <ns5:wikiPageExternalLink rdf:resource="http://en.wikipedia.org/wiki/Raven_%28comics%29"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tara Strong</ns4:altLabel>
