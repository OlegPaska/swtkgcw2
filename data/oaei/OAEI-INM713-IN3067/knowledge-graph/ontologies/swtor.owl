  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Diplomat">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Corellian"/>
    <rdfs:comment xml:lang="en">A diplomat is someone involved in diplomacy, the art and practice of conducting negotiations between representatives of groups or states. They were studious followers of politics and law. Some were devoted to free democracy. Others, like the Separatist senators, are more interested in their own needs. Jedi Master Adi Gallia's parents are noted Corellian diplomats.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Titles"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Titles"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Diplomat</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Diatium_Onslaught_armor.png"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">diplomats</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">A diplomat is someone involved in diplomacy, the art and practice of conducting negotiations between representatives of groups or states. They were studious followers of politics and law. Some were devoted to free democracy. Others, like the Separatist senators, are more interested in their own needs. Jedi Master Adi Gallia's parents are noted Corellian diplomats.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Senator"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Diplomat</ns4:altLabel>
  </rdf:Description>
