  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Randor_Mohl">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Humans"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Randor_Mohl.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Outpost_Rennar"/>
    <rdfs:comment xml:lang="en">{{ #if: |
Randor Mohl was a male Human Mandalorian clan leader who lived during the Cold War. On Tatooine, him and his clan had set up a outpost out in the desert, testing themselves against the Tusken Raiders and creatures living there. He wore blue Mandalorian armor.

</rdfs:comment>
