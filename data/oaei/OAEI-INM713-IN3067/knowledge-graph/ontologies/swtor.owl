    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Malak"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Revan"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire_(Jedi_Civil_War)"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire (Jedi Civil War)</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/faction"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Empire</ns5:wikiPageWikiLinkText>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Theocratic Empire</ns1:type>
    <ns1:leader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Revan"/>
    <ns1:secondary rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Malak"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Civil_War"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith.</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Civil_War"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revan's Sith Empire</ns5:wikiPageWikiLinkText>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire (Jedi Civil War)</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Vitiate_declared_himself_Emperor.png"/>
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Order</ns1:allegiance>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Empire (Jedi Civil War)</ns4:altLabel>
    <ns1:capital rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Korriban"/>
    <rdfs:comment xml:lang="en">The Sith Empire was founded by Dark Lord of the Sith, Darth Revan, and his apprentice, Darth Malak, as a dark side organization in direct opposition to the Galactic Republic and its Jedi defenders. The Empire fought the Republic in the Jedi Civil War. Malak moved against his master however. He attacked Revan's starship and left him for dead, taking the mantle of Dark Lord of the Sith.
Revan survived and had his memory erased, a controversial decision by the Jedi Council. He was retrained as a Jedi and he ultimately slew Malak and destroyed the Empire, thereby ending the war.</rdfs:comment>
    <ns1:locations rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lehon"/>
    <ns5:abstract xml:lang="en">The Sith Empire was founded by Dark Lord of the Sith, Darth Revan, and his apprentice, Darth Malak, as a dark side organization in direct opposition to the Galactic Republic and its Jedi defenders. The Empire fought the Republic in the Jedi Civil War. Malak moved against his master however. He attacked Revan's starship and left him for dead, taking the mantle of Dark Lord of the Sith.
Revan survived and had his memory erased, a controversial decision by the Jedi Council. He was retrained as a Jedi and he ultimately slew Malak and destroyed the Empire, thereby ending the war.</ns5:abstract>
  </rdf:Description>
