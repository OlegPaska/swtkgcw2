  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kari_Wahlgren">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kari Wahlgren</ns4:altLabel>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Home_hdsht.jpg?width=300"/>
    <ns5:wikiPageExternalLink rdf:resource="http://www.kariwahlgren.net"/>
    <ns5:abstract xml:lang="en">Kari Wahlgren is an American actress who provided the voice for the female Jedi Knight.
She has provided English dubbing for dozens of cartoons, anime, and video games including The Old Republic. She is known for animated movies such as Bolt, Kung Fu Panda, and Tangled.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Home_hdsht.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kari Wahlgren</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <rdfs:comment xml:lang="en">Kari Wahlgren is an American actress who provided the voice for the female Jedi Knight.
She has provided English dubbing for dozens of cartoons, anime, and video games including The Old Republic. She is known for animated movies such as Bolt, Kung Fu Panda, and Tangled.

</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Home_hdsht.jpg"/>
    <ns5:wikiPageExternalLink rdf:resource="http://www.imdb.com/name/nm1312566/"/>
  </rdf:Description>
