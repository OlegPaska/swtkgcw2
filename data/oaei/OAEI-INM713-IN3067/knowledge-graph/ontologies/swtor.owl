    <ns5:abstract xml:lang="en">Flying Fists has a 50% chance to immediately regrant Upper Hand when hitting a bleeding target. This effect cannot occur more than once every 10 seconds.

</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Round_Two.png"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Flying Fists has a 50% chance to immediately regrant Upper Hand when hitting a bleeding target. This effect cannot occur more than once every 10 seconds.</ns1:description>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <rdfs:comment xml:lang="en">Flying Fists has a 50% chance to immediately regrant Upper Hand when hitting a bleeding target. This effect cannot occur more than once every 10 seconds.

</rdfs:comment>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Round_Two.PNG"/>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
