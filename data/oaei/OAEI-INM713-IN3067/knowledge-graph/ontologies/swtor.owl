    <ns1:mission2difficultygrey rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115</ns1:mission2difficultygrey>
    <ns1:mission7description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sensors have discovered new and unexplored ancient ruins on the moon Dxun. To beat other treasure seekers to it, send a companion to claim its fortune.</ns1:mission7description>
    <ns1:mission1time rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">240.0</ns1:mission1time>
    <ns1:mission6yield rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Grade 1 Gemstones</ns1:mission6yield>
    <ns1:mission7name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Uncharted Means Unclaimed</ns1:mission7name>
