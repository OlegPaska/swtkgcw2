  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gand_(planet)">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Gand (planet)</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Outer_Rim_Planets"/>
    <ns1:terrain rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">&gt;Ammonia-filled mistsRocky Landscape</ns1:terrain>
    <ns5:abstract xml:lang="en">Gand is a planet located in the Outer Rim Territories on the border of Wild Space, and is the homeworld of the species of the same name. The surface is covered in thick mists separating minor colonies, and the planet itself is ruled by a totalitarian government. The five orbiting space stations are locations for trade.

</ns5:abstract>
