  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kaleth">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kaleth</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Je%27daii_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Avatar107.gif"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Wars"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tython"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kaleth</rdfs:label>
    <ns5:abstract xml:lang="en">Kaleth, or the Temple of Knowledge is one of nine temples of the Je'daii Order located on the lush and dangerous world of Tython. A large stone structure with four large, square towers, the temple at Kaleth served as a repository of knowledge and wisdom for many generations. After the devastating Force Wars, the Jedi left Tython and others came to live in the ruins of the ancient fortress-city. By the time the Jedi Order returned to their ancient homeworld during the Cold War between the Galactic Republic and the resurgent Sith Empire, the temple at Kaleth was no more than ruins.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <rdfs:comment xml:lang="en">Kaleth, or the Temple of Knowledge is one of nine temples of the Je'daii Order located on the lush and dangerous world of Tython. A large stone structure with four large, square towers, the temple at Kaleth served as a repository of knowledge and wisdom for many generations. After the devastating Force Wars, the Jedi left Tython and others came to live in the ruins of the ancient fortress-city. By the time the Jedi Order returned to their ancient homeworld during the Cold War between the Galactic Republic and the resurgent Sith Empire, the temple at Kaleth was no more than ruins.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kaleth</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
  </rdf:Description>
