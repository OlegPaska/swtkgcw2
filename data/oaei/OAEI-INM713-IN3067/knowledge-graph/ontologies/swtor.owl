  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Color_Crystal_(Weapon_Modification)">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Modifications"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Color Crystal (Weapon Modification)</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Artifice"/>
    <rdfs:comment xml:lang="en">A color crystal is a modification item for weapons that both improves the weapon's statistics and changes the visual (color) appearance of a weapon or its fired bolts. Most color crystals apply a single color, but some have a multi-color effect.
Color crystals can be obtained as dropped items in game, or crafted via the Artifice crew skill (see Color Crystal (Artifice-crafted)).</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Modifications"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Color Crystal (Weapon Modification)</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Color Crystal (Weapon Modification)</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Color Crystal</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">A color crystal is a modification item for weapons that both improves the weapon's statistics and changes the visual (color) appearance of a weapon or its fired bolts. Most color crystals apply a single color, but some have a multi-color effect.
Color crystals can be obtained as dropped items in game, or crafted via the Artifice crew skill (see Color Crystal (Artifice-crafted)).</ns5:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Crafting-screen-artifice.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Color_Crystal_(Artifice-crafted)"/>
  </rdf:Description>
