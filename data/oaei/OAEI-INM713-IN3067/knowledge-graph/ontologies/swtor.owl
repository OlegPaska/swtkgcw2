  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sky_Princess">
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Underworld</ns1:allegiance>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lore/Starships"/>
