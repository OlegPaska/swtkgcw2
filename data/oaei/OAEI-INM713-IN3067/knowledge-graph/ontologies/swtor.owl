    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rakghoul Vaccine</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rakghoul Vaccine</ns4:altLabel>
    <rdfs:comment xml:lang="en">The Rakghoul Vaccine was an item acquired by participating in the Rakghoul Pandemic world event. When used it cured the Rakghoul Plague and provided immunity from it for a limited time. It was given as a reward to certain missions that were part of the event and was also sold by medical droids during and shortly after the event.</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Crimsonrakling.jpg"/>
    <ns5:abstract xml:lang="en">The Rakghoul Vaccine was an item acquired by participating in the Rakghoul Pandemic world event. When used it cured the Rakghoul Plague and provided immunity from it for a limited time. It was given as a reward to certain missions that were part of the event and was also sold by medical droids during and shortly after the event.</ns5:abstract>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cost"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Rakghoul_Pandemic"/>
  </rdf:Description>
