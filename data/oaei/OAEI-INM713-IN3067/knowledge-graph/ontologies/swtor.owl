    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Crimson_Fleece"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Underworld"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Vanguard (starship)</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Battle_on_the_Hydian_Way"/>
    <ns1:commanders rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hylo_Visz"/>
    <ns1:escape rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:escape>
    <ns1:crew rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:crew>
    <ns1:length rdf:datatype="http://dbkwik.webdatacommons.org/datatype/metre">94.0</ns1:length>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic_Encyclopedia"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Vanguard</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Great_Galactic_War"/>
    <ns1:allegiance rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Underworld</ns1:allegiance>
    <ns1:armament rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">&gt;2 Dual laser cannonsMissile launchers</ns1:armament>
    <ns5:abstract xml:lang="en">The Vanguard was the prototype of the Defender-class light corvette, the ship was however, stolen by the Mirialan smuggler Hylo Visz before it's first test flight, and she continued to use it throughout her criminal career. The Vanguard replaced the Crimson Fleece that was destroyed by the Rendili Vehicle Corporation.


</ns5:abstract>
