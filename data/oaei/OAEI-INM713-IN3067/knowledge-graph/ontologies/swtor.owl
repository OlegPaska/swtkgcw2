  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Togruta">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Planets"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Avatar56.gif?width=300"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/species"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Togruta</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">The Togruta were a species of bipedal sentient beings from the planet Shili. They were identified primarily by the three head-tails growing from their craniums, their orange or blue skin, and white tattoos. They are available as a playable species with Patch 3.3.

</ns5:abstract>
