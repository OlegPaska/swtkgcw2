  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Guun_Han_Saresh">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Guun_Han_Saresh.jpg?width=300"/>
