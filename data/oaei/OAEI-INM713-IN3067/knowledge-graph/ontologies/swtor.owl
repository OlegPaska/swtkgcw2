  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Scout_(Tatooine)">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Scout (Tatooine)</rdfs:label>
    <ns5:abstract xml:lang="en">Mandalorian Scouts were a unit of Mandalorians that were members of a Mandalorian clan that were hired by a local warlord to guard his cannons as they fire on Imperial forces.

</ns5:abstract>
