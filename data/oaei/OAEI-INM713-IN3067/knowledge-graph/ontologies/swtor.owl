  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sticky_Grenade">
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">15.0</ns1:cooldown>
    <rdfs:comment xml:lang="en">An ability that can be learned by a new trooper in the field.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sticky Grenade</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesammo"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ranged</ns1:type>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sticky Grenade</ns5:wikiPageWikiLinkText>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sticky_Grenade.png?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Trooper</ns1:class>
    <ns1:cells rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns1:cells>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">30m</ns1:range>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sticky Grenade</ns1:name>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Sticky_Grenade.PNG"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Sticky_Grenade.PNG"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sticky Grenade</ns4:altLabel>
    <ns5:abstract xml:lang="en">An ability that can be learned by a new trooper in the field.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Throws a sticky grenade that will detonate after several seconds. Standard and weak enemies enter a state of panic when the grenade is active. The explosion deals 1903 - 2264 kinetic damage when it detonates. Standard and weak targets are knocked back from the blast.</ns1:description>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sticky_Grenade.png"/>
  </rdf:Description>
