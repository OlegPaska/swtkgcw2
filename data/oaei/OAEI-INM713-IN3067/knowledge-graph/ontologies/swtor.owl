  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sphere_of_Biotic_Science">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Biotic Science</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Spheres_of_Influence"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Spheres_of_Influence"/>
    <ns5:abstract xml:lang="en">The Sphere of Biotic Science is one of the twelve Spheres of Influence within the reconstituted Sith Empire. Ruled by a member of the Dark Council, the Sphere controlled all alchemical and biotic science within the Empire, sharing joint control of the Imperial Science Bureau with the Sphere of Technology. Darth Acharon was head of the Sphere during the Cold War with the Galactic Republic, and in that position he oversaw the branches of the Empire that dealt in cybernetic augmentation and physical enhancement, often in conjunction with Sith alchemy and magic.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Biotic Science</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Biotic Science</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SWTOR_Space_Missions_(2).jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <rdfs:comment xml:lang="en">The Sphere of Biotic Science is one of the twelve Spheres of Influence within the reconstituted Sith Empire. Ruled by a member of the Dark Council, the Sphere controlled all alchemical and biotic science within the Empire, sharing joint control of the Imperial Science Bureau with the Sphere of Technology. Darth Acharon was head of the Sphere during the Cold War with the Galactic Republic, and in that position he oversaw the branches of the Empire that dealt in cybernetic augmentation and physical enhancement, often in conjunction with Sith alchemy and magic.</rdfs:comment>
  </rdf:Description>
