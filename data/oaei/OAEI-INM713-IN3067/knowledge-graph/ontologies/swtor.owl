  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bakkel">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Females"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Females"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Beast_Rider"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Onderon"/>
    <ns1:faction rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Beast_Rider"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Iziz"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Beast_Riders"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Humans"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
    <ns5:abstract xml:lang="en">Bakkel was a female Beast Rider from Onderon. She was killed by the Jedi Exile in Iziz on Onderon while the Exile was seeking holodiscs for Dhagon Ghent. Bakkel refused to give the holodiscs to the Exile and became hostile forcing the Exile to kill her and her companions. She and her companions were often seen in the Beast Riders' Den in the Western Square's cantina.

</ns5:abstract>
    <ns1:status rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Deceased</ns1:status>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bakkel</ns1:name>
