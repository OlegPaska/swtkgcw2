  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dealers_Den">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dealers Den Cantina</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Coruscant"/>
    <ns5:wikiPageExternalLink rdf:resource="http://starwars.wikia.com/wiki/Jedi_Temple"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:wikiPageExternalLink rdf:resource="http://evil-wizards.org/swtor-wiki/index.php?title=Forum_rp_Guide"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Deadly_Canon.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:abstract xml:lang="en">The Dealer's Den is a Cantina located in the corner of the Galactic Market on the planet Coruscant. It offers drinks dancers and gambling as its entertainment. Most of its patrons are the seedier denizens of Coruscant society, such as bounty hunters, spice dealers and Smuggler.
It is a social hub, and other than being used in a few Republic quests it has become a hotspot for RolePlayers.[1] For information on this subject beyond The Old Republic, see: Wookieepedia's page on Dealer's Den
</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bounty_Hunter"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dealers Den</ns4:altLabel>
    <rdfs:comment xml:lang="en">The Dealer's Den is a Cantina located in the corner of the Galactic Market on the planet Coruscant. It offers drinks dancers and gambling as its entertainment. Most of its patrons are the seedier denizens of Coruscant society, such as bounty hunters, spice dealers and Smuggler.
It is a social hub, and other than being used in a few Republic quests it has become a hotspot for RolePlayers.[1] For information on this subject beyond The Old Republic, see: Wookieepedia's page on Dealer's Den
</rdfs:comment>
    <ns5:wikiPageExternalLink rdf:resource="http://starwars.wikia.com/wiki/Dealer%27s_Den"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dealers Den</rdfs:label>
