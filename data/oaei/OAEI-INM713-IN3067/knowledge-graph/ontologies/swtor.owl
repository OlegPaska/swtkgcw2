  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lifted_(Force)">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Debuffs"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cabilities"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stun</ns1:type>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lifted (Force)</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <rdfs:comment xml:lang="en">Lifted (Force) is an affect applied to a target using an ability such as Force Lift. It prevents the target from taking any action for a period of time. A visual affect of showing the target lifted into the air will be shown for the duration.
</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <ns5:abstract xml:lang="en">Lifted (Force) is an affect applied to a target using an ability such as Force Lift. It prevents the target from taking any action for a period of time. A visual affect of showing the target lifted into the air will be shown for the duration.
</ns5:abstract>
