  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Hostage_Situation_Cleanup">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">[HEROIC 2+] Hostage Situation Cleanup</ns5:wikiPageWikiLinkText>
