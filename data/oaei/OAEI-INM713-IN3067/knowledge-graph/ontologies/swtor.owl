  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Progenitor">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Manaan"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Progenitor</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Progenitor</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi"/>
    <rdfs:comment xml:lang="en">The Progenitor was a giant female Firaxan Shark from Manaan. The Progenitor was believed to make all the kolto on Manaan. It was driven mad when the Republic set up an Hrakert Station there to harvest the kolto. It made the other firaxan sharks attack the scientists at the outpost. When the Jedi Revan destroyed the harvester the Progenitor calmed down.


</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Progenitor</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kolto"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Revan"/>
    <ns5:abstract xml:lang="en">The Progenitor was a giant female Firaxan Shark from Manaan. The Progenitor was believed to make all the kolto on Manaan. It was driven mad when the Republic set up an Hrakert Station there to harvest the kolto. It made the other firaxan sharks attack the scientists at the outpost. When the Jedi Revan destroyed the harvester the Progenitor calmed down.


</ns5:abstract>
