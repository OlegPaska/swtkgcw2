    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Alderaan"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death Mark Laser (superweapon)</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire_superweapons"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death Mark Laser</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Desolator_(superweapon)"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Deagan.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death Mark laser</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Superweapons"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Knight_Story_Missions"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Superweapons"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Alderaan"/>
    <rdfs:comment xml:lang="en">The Death Mark Laser is a superweapon designed by the brilliant Sith scientist Tarnis during the Cold War, the device forms part of the Desolator superweapon. Darth Angral deployed the weapon on Alderaan to test its capability's, the Jedi Knight however put a stop to the Sith Lords plans and destroyed the superweapon.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire_superweapons"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/image"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Alderaan"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Lord"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1337428569_novare_coast_01.jpg"/>
    <ns5:abstract xml:lang="en">The Death Mark Laser is a superweapon designed by the brilliant Sith scientist Tarnis during the Cold War, the device forms part of the Desolator superweapon. Darth Angral deployed the weapon on Alderaan to test its capability's, the Jedi Knight however put a stop to the Sith Lords plans and destroyed the superweapon.

</ns5:abstract>
  </rdf:Description>
