    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/GamorreanCA.jpg?width=300"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Gamorrean.jpg"/>
