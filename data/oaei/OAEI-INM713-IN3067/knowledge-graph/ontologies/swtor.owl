  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sons_of_Palawa">
    <rdfs:comment xml:lang="en">The Sons of Palawa are a ritualistic tribal group that have arrived on Tatooine to test themselves against the harsh environment. They have also obtained usage of Czerka battle droids recovered from equipment left behind when the Czerka Corporation left Tatooine. They are hostile towards Imperial forces, considering them invaders of Tatooine.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tatooine"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Czerka_Corporation"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sons of Palawa</ns5:wikiPageWikiLinkText>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-09-20_08-46-01-13.png"/>
    <ns5:abstract xml:lang="en">The Sons of Palawa are a ritualistic tribal group that have arrived on Tatooine to test themselves against the harsh environment. They have also obtained usage of Czerka battle droids recovered from equipment left behind when the Czerka Corporation left Tatooine. They are hostile towards Imperial forces, considering them invaders of Tatooine.</ns5:abstract>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sons of Palawa</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sons of Palawa</rdfs:label>
  </rdf:Description>
