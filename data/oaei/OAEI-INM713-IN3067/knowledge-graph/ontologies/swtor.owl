  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Kick">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force_Kick.png?width=300"/>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">12.0</ns1:cooldown>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Kick</ns1:name>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:resource>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Kick</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Kick</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force_Kick.png"/>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Force_Kick.PNG</ns1:icon>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Kick</ns1:link>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kicks the target and interrupts its current action, preventing that ability from being used for the next 4 seconds.</ns1:description>
    <ns1:activation rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:activation>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ns1:range>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Kick</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mission:Factory_Recall">
