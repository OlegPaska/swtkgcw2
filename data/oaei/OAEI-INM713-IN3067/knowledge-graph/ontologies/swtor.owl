    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gundark"/>
    <ns1:faction rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/character"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Deth Kregg</rdfs:label>
