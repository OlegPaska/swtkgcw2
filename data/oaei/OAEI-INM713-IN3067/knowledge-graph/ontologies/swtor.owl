  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Flingeld">
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Flingeld</ns1:name>
    <ns5:abstract xml:lang="en">{{ #if: |
Flingeld is a male Human Jedi Padawan serving the Jedi Order and the Galactic Republic during the Cold War with the resurgent Sith Empire.

</ns5:abstract>
    <rdfs:comment xml:lang="en">{{ #if: |
