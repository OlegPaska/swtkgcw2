  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Academy_(Dromund_Kaas)">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Malgus"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Academy (Dromund Kaas)</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sith Academy (Dromund Kaas)</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Dromund_Kaas"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Order"/>
    <ns5:abstract xml:lang="en">This Sith Academy is located on the Imperial capital world of Dromund Kaas. It is likely that prior to the recapture of Korriban, during the Empire's isolation and early days of the Great Galactic War, that this was the primary Sith training facility. Darth Malgus trained at the academy.

</ns5:abstract>
