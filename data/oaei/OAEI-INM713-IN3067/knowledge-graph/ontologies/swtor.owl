    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Wars"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Light and Darkness War</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ruusan_campaign"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Army_of_Light"/>
    <ns5:abstract xml:lang="en">The Light and Darkness War was a name given to the final decade of the New Sith Wars. The conflict ended with the pivotal Ruusan campaign, where the Brotherhood of Darkness was defeated by the Army of Light.</ns5:abstract>
    <rdfs:comment xml:lang="en">The Light and Darkness War was a name given to the final decade of the New Sith Wars. The conflict ended with the pivotal Ruusan campaign, where the Brotherhood of Darkness was defeated by the Army of Light.</rdfs:comment>
  </rdf:Description>
