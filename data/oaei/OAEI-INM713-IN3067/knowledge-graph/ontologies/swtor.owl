    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/hostagecleanupswtor.jpg"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mission:Hostage Situation Cleanup</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Agent"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hostage Situation Cleanup</ns5:wikiPageWikiLinkText>
