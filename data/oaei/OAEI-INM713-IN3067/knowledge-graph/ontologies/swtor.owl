    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/VX-5_Ricker.jpg"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">VIP Lounge Wristband</ns4:altLabel>
