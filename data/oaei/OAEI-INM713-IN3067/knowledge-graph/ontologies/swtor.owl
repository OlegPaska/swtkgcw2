  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic:_Shadow_of_Revan">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Star Wars: The Old Republic: Shadow of Revan</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Revanites"/>
    <ns1:platform rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">PC</ns1:platform>
    <ns1:genre rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">MMORPG</ns1:genre>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Star Wars: The Old Republic: Shadow of Revan</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Shadow_of_revan.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns1:author rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <rdfs:comment xml:lang="en">Shadow of Revan is the fourth expansion to the massively multiplayer online roleplaying game (MMORPG), Star Wars: The Old Republic, set in the Old Republic era and the second paid expansion. It was developed by BioWare, a division of Electronic Arts and was released on 2nd December 2014 to those who pre-ordered the game and December 9th 2014 to the rest of the world. The expansion costs $19.99 US dollars or £11.99 GBP and includes a new maximum level cap of 60.
The expansion is a continuation of the "Forged Alliances" story arc, but it is not necessary to complete the arc for the expansion.

</rdfs:comment>
    <ns1:publisher rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">EA, LucasArts</ns1:publisher>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/BioWare"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Shadow_of_revan.jpg?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Expansions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Civil_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Expansions"/>
    <ns1:release rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-02</ns1:release>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SithEmblemTOR.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns1:engine rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">HeroEngine</ns1:engine>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/media"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">''Star Wars: The Old Republic: Shadow of Revan''</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Forged Alliances and Shadow of Revan</ns5:wikiPageWikiLinkText>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shadow of Revan</ns1:name>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Star Wars: The Old Republic: Shadow of Revan</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Revan"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Star Wars - The Old Republic: Shadow of Revan</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shadow of Revan</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">Shadow of Revan is the fourth expansion to the massively multiplayer online roleplaying game (MMORPG), Star Wars: The Old Republic, set in the Old Republic era and the second paid expansion. It was developed by BioWare, a division of Electronic Arts and was released on 2nd December 2014 to those who pre-ordered the game and December 9th 2014 to the rest of the world. The expansion costs $19.99 US dollars or £11.99 GBP and includes a new maximum level cap of 60.
The expansion is a continuation of the "Forged Alliances" story arc, but it is not necessary to complete the arc for the expansion.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns1:developer rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/BioWare"/>
    <ns1:release rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-09</ns1:release>
  </rdf:Description>
