    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Humanocentrism</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lower_City_(Taris)"/>
    <rdfs:comment xml:lang="en">Humanocentrism is a tendency to view the galaxy and events from a Human perspective, and demonstrated xenophobia towards non-Humans. 

</rdfs:comment>
  </rdf:Description>
