    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Vette01.jpg"/>
    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Vette"/>
