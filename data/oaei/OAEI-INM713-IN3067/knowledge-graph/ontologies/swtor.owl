  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tom_Spackman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bounty_Hunters"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bounty_Hunters"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Spackman.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <ns5:wikiPageExternalLink rdf:resource="http://www.imdb.com/name/nm0816489/"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tom Spackman</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tom Spackman</rdfs:label>
    <ns5:abstract xml:lang="en">Tom Spackman is an American actor who provided the voice and dialogue for the male bounty hunter.
He is known for his work on Walk off Broadway and Brass in addition to Star Wars: The Old Republic.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Spackman.jpg"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Spackman.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bounty_Hunter"/>
    <rdfs:comment xml:lang="en">Tom Spackman is an American actor who provided the voice and dialogue for the male bounty hunter.
He is known for his work on Walk off Broadway and Brass in addition to Star Wars: The Old Republic.

</rdfs:comment>
  </rdf:Description>
