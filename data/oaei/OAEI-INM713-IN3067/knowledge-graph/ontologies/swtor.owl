    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slow-Release Medpac</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Slow-Release Medpac</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesenergy"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Slow-Release_Medpac_Icon.jpg"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Healing</ns1:type>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sawbones_(Skill_Tree)"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">30m</ns1:range>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Slow-Release_Medpac_Icon.jpg"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Injects the target with slow release medicine, healing for X over 18 seconds.</ns1:description>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Scoundrel"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns5:abstract xml:lang="en">Slow-Release Medpac is an ability available to the Scoundrel from the Sawbones skill Slow-Release Medpac. It heals a moderate amount of health over 15 seconds and is stackable to up to 2 medpacs. It costs 15 energy, has a range of 30 and is instant cast with no cooldown.


</ns5:abstract>
    <rdfs:comment xml:lang="en">Slow-Release Medpac is an ability available to the Scoundrel from the Sawbones skill Slow-Release Medpac. It heals a moderate amount of health over 15 seconds and is stackable to up to 2 medpacs. It costs 15 energy, has a range of 30 and is instant cast with no cooldown.


</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jaesa%27s_Ship">
    <rdfs:comment xml:lang="en">Towards the end of the Cold War, Jedi Padawan Jaesa Willsaam uses her starship to travel to the distant outer rim and meets with the Sith Warrior in an attempt to free her master, Nomen Karr. The Warrior turns the tables and convinces her to join him in his quest.

</rdfs:comment>
