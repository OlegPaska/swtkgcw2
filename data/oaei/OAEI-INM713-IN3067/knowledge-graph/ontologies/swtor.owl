  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Convict">
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Convict</ns1:name>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns1:race rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Humans"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Belsavis"/>
    <rdfs:comment xml:lang="en">Mandalorian Convicts were Mandalorians taken prisoner after they destroyed a backwater planet by the Galactic Republic. However they broken free when riots started on Belsavis by the Sith Empire (New Established Sith Empire). They were armed with vibroswords.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
