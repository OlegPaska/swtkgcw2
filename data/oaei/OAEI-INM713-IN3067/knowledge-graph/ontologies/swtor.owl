  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Juran_Mountains">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/House_Thul"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Juran Mountains</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Havoc_Squad"/>
    <ns5:abstract xml:lang="en">The Juran Mountains is a major area of Alderaan and listed in the in-game Locations sub-section of the Codex. It is one of 6 locations listed for Alderaan.The Codex entry is unlocked simply by traveling into the area, which is located southeast of Kaamos Territory and northeast of King's Pass.


</ns5:abstract>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Juran Mountains</ns5:wikiPageWikiLinkText>
