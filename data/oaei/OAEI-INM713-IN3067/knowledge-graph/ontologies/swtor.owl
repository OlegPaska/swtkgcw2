    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shen Matale</rdfs:label>
    <rdfs:comment xml:lang="en">Shen Matale was the son of Ahlan Matale. He fell in love with Rahasia Sandral, the daughter of his father's mortal enemy.

</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shen</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">Shen Matale was the son of Ahlan Matale. He fell in love with Rahasia Sandral, the daughter of his father's mortal enemy.

</ns5:abstract>
