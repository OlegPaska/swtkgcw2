  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Planetary_Commendations">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Planetary Commendations</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Armors"/>
    <rdfs:comment xml:lang="en">Planetary Commendations are tokens used to purchase gear in the supplies section of the Republic Fleet. Planetary commendations can be gained by completing missions, defeating enemies and even by using other commendations to buy them. With planetary commendations Prototype gear can be purchased for the corresponding level. </rdfs:comment>
