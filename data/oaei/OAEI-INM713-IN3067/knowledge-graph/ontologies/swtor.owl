  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_Leadership_:_Mark_III">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat Leadership : Mark III</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tython"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cost"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Colicoid_war_game.jpg"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat Leadership : Mark III</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Padawan"/>
    <ns5:abstract xml:lang="en">Liam Dentiri instructs the many Padawans on Tython in physical combat. He has preprogrammed several combat scenarios to test your skills and abilities in battle and has offered you a chance to prove yourself. You have successfully completed the first and second scenarios, and Liam hopes to challenge you with the third. Find one of the training consoles around the Jedi Temple courtyard, activate it, and complete the training scenario.

</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat Leadership : Mark III</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Liam_Dentiri"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions"/>
    <rdfs:comment xml:lang="en">Liam Dentiri instructs the many Padawans on Tython in physical combat. He has preprogrammed several combat scenarios to test your skills and abilities in battle and has offered you a chance to prove yourself. You have successfully completed the first and second scenarios, and Liam hopes to challenge you with the third. Find one of the training consoles around the Jedi Temple courtyard, activate it, and complete the training scenario.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython_Missions"/>
