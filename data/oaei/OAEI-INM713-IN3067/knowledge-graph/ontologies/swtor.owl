  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Armor">
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Heal</ns1:role>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force</ns1:resource>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Armor</ns1:name>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Surrounds the target in a Force shield that absorbs a high amount of damage and lasts 30 seconds.  The target becomes Force-imbalanced and cannot benefit from Force Armor again for 20 seconds.</ns1:description>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:range>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Armor</ns1:link>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Armor.png"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Armor.png?width=300"/>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:cooldown>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Armor</rdfs:label>
    <ns1:cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</ns1:cost>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Armor</ns4:altLabel>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Ability Force Armor.png</ns1:icon>
    <ns1:activation rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:activation>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Armor</ns5:wikiPageWikiLinkText>
  </rdf:Description>
