    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mid_Rim_Planets"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kashyyyk</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mid_Rim_Planets"/>
    <ns5:abstract xml:lang="en">Kashyyyk is the lush and heavily forested homeworld of the Wookiees. It is located in the same star system as the Trandoshan homeworld of Trandosha, a fact that has led to bitter bloodfeuds and other conflicts between the two neighbouring species.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic_planets"/>
