  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Serenno">
    <rdfs:comment xml:lang="en">Serenno was a planet in the Outer Rim Territories. It was known for its aristocratic Counts and was also well known for its long history of resisting authority.
During the Great Galactic War, Serenno was attacked and captured by the forces of the Sith Empire, under the command of the Sith Lord Darth Malgus. The Counts were amongst the wealthiest beings in the galaxy and believed in noblesse oblige and self-reliance. Serenno capital backed many projects of the Galactic Republic of which the planet was a valued member, despite being a frequent hotbed of sedition.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Serenno</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Lord_(title)"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Outer_Rim_Planets"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Outer_Rim"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Serenno</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Serenno.png"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Serenno.png"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Planets"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Serenno</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Planets"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageExternalLink rdf:resource="http://en.wikipedia.org/wiki/Noblesse_oblige"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Houses_of_Serenno"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Malgus"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Outer_Rim_Planets"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Serenno.png?width=300"/>
    <ns5:abstract xml:lang="en">Serenno was a planet in the Outer Rim Territories. It was known for its aristocratic Counts and was also well known for its long history of resisting authority.
During the Great Galactic War, Serenno was attacked and captured by the forces of the Sith Empire, under the command of the Sith Lord Darth Malgus. The Counts were amongst the wealthiest beings in the galaxy and believed in noblesse oblige and self-reliance. Serenno capital backed many projects of the Galactic Republic of which the planet was a valued member, despite being a frequent hotbed of sedition.</ns5:abstract>
  </rdf:Description>
