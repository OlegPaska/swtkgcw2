  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Concealment_(Discipline)">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Concealment (Discipline)</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Operative_Disiplines"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Operative_Disiplines"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Concealment (Discipline)</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/T7-O1.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Disiplines"/>
    <rdfs:comment xml:lang="en">Concealment is one of the three Disciplines avaible to the Operative Advanced Class. It focuses on stealthed burst damage.
Striking from the shadows, the Concealment Operative surprises the enemy with a flurry of calculated attacks designed to stun and debilitate. Then, before the fight gets out of hand, the Concealment Operative can return to a position of stealth, biding their time until the time to strike reveals itself again.
</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Disiplines"/>
    <ns5:abstract xml:lang="en">Concealment is one of the three Disciplines avaible to the Operative Advanced Class. It focuses on stealthed burst damage.
Striking from the shadows, the Concealment Operative surprises the enemy with a flurry of calculated attacks designed to stun and debilitate. Then, before the fight gets out of hand, the Concealment Operative can return to a position of stealth, biding their time until the time to strike reveals itself again.
</ns5:abstract>
  </rdf:Description>
