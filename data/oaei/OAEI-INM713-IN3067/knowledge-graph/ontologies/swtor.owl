  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Psychic_Absorption">
    <ns1:description rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Serenity_Strike"/>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:range>
    <ns5:abstract xml:lang="en">Increases the life redirected by Force In Balance and Serenity Strike and causes Sever Force and Force Technique's Force Breach effect to steal life from enemy targets, healing you for 25% of the damage they deal.
Level Granted : 52</ns5:abstract>
