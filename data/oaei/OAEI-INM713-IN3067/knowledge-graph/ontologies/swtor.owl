  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Warship">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns5:abstract xml:lang="en">The term warship is often used to identify the subclass of starships designed primarily for use as combatants, as opposed to civilian use, support or yard operations.</ns5:abstract>
