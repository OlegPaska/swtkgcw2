  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Incendiary_Mine">
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Incendiary Mine</ns1:name>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Incendiary Mine</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Incendiary Mine</rdfs:label>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Incendiary Mine</ns1:link>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Increases the duration of your Scrambling Field by 5 seconds.  In addition, when you activate Hightail It, you detonate an Incendiary Mine that deals 1543 internal damage to all nearby enemies over the duration.  Targets that remain within are additionally slowed by 70% for the duration.  Lasts 8 seconds.  Does not affect sleeping or incapacitated targets.</ns1:description>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Incendiary_Mine.png?width=300"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Incendiary_Mine.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Incendiary Mine</ns5:wikiPageWikiLinkText>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Incendiary_Mine.PNG</ns1:icon>
  </rdf:Description>
  <rdf:Description rdf:about="http://swtor.wikia.com/wiki/Special:FilePath/Fr02_535x300.jpg?width=300">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/ontology/Image"/>
