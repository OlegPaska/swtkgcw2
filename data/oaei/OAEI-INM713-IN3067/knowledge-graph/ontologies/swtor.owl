    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Initiate"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi Initiate Trials</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Initiate Trials</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Padawans"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Padawans"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Masters"/>
    <rdfs:comment xml:lang="en">The Jedi Intiate Trials were the tests by which Jedi Initiates were given as prerequisite in order to progress to the level of Padawan within the Jedi Order. Like the Trials of Knighthood, these tests were required to be taken by all students in order to proceed to the next rank in the Jedi Order.</rdfs:comment>
    <ns5:abstract xml:lang="en">The Jedi Intiate Trials were the tests by which Jedi Initiates were given as prerequisite in order to progress to the level of Padawan within the Jedi Order. Like the Trials of Knighthood, these tests were required to be taken by all students in order to proceed to the next rank in the Jedi Order.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Padawan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Military_Adrenals">
    <ns5:abstract xml:lang="en">This lore can be found on Quesh. 
Republic: X: 76, Y:1263 This lore is obtained in the Broga's Palace while doing the mission 'The Republic Strikes Back'. 
Empire: x:-87 y:554 This lore is obtained during the quest 'Blood and Venom', it is received while talking with Sergeant Molvar. 

</ns5:abstract>
