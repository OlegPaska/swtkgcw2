    <ns1:mission6name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Know Too Much</ns1:mission6name>
    <ns1:mission2time rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:mission2time>
    <ns1:mission3description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">A corporation has discovered the cure to the deadly C5H4 virus, but refuses to release it to the public. Have your companion negotiate the purchase of the cure and release it.</ns1:mission3description>
