    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kolto Residue</rdfs:label>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kolto Residue</ns1:name>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kolto Residue</ns4:altLabel>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kolto Bomb leaves a residue on up to 8 enemies in its area of impact, reducing movement speed by 50% for 3 seconds.  In addition, Advannced Medical Probe grants Invigorated to its target, increasing healing received by 3% for 45 seconds.</ns1:description>
