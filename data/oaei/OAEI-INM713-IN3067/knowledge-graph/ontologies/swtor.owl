    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tularan_Marsh">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Taris"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tularan Marsh</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tularan Marsh</rdfs:label>
    <rdfs:comment xml:lang="en">Tularan Marsh is directly northeast of The Brell Sediment on Taris. It is a swampy area now. Before the bombardment of Taris centuries ago, there was a Tularan Skyway in one of the industrial zones of Taris. The Republic has not yet ventured into the area in full force, leaving it currently occupied by Rakghouls and pirates.

</rdfs:comment>
