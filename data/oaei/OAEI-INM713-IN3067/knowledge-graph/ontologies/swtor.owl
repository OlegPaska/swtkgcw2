  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ubrikkian_Striker">
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/expand"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ubrikkian Striker</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Vehicle_Ubrikkian_Striker.png"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ubrikkian Striker</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">The Ubrikkian Striker is a vehicle that can be purchased by a player to use in Star Wars: The Old Republic, it is available for purchase at level 25 for 8,000 credits from Londrod on Tatooine. This mount increases its speed by 90% and has seating for one extra passenger.</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Vehicles"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Vehicles"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ubrikkian Striker</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Londrod"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Vehicle_Ubrikkian_Striker.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tatooine"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Vehicle_Ubrikkian_Striker.png"/>
    <ns5:abstract xml:lang="en">The Ubrikkian Striker is a vehicle that can be purchased by a player to use in Star Wars: The Old Republic, it is available for purchase at level 25 for 8,000 credits from Londrod on Tatooine. This mount increases its speed by 90% and has seating for one extra passenger.</ns5:abstract>
  </rdf:Description>
