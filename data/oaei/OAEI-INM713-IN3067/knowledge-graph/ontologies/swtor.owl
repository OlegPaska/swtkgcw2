    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_kotfe_skytrooperpod_concept.jpg?width=300"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Zakuulan-Boarding-Pod-2.jpg"/>
