  <rdf:Description rdf:about="http://swtor.wikia.com/wiki/Special:FilePath/Jedi_Knight_by_ivelin.jpg">
    <ns3:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Jedi_Knight_by_ivelin.jpg?width=300"/>
    <ns2:rights rdf:resource="http://swtor.wikia.com/wiki/File:Jedi_Knight_by_ivelin.jpg"/>
