    <ns1:mission3difficultygrey rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:mission3difficultygrey>
    <ns1:mission7description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">A distress call is coming from within the Orixon Nebula, declared off-limits by the Hutts. Send your companion to negotiate passage for a rescue ship.</ns1:mission7description>
