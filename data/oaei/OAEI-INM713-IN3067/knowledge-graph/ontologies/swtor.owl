    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Stubs"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Overhead Slash</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesfocus"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Overhead_Slash.jpg"/>
    <ns1:focusUse rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ns1:focusUse>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Overhead_Slash.jpg?width=300"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Overhead Slash</rdfs:label>
    <ns5:abstract xml:lang="en">Overhead Slash is an ability available to the Jedi Knight at level 4. It costs 5 focus, has a range of 4m and a cooldown of 6 seconds.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Overhead_Slash.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight"/>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">6.0</ns1:cooldown>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Overhead_Slash.jpg"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Acrobatic melee attack that does very high damage to a single target and knocks them down for a short duration. Strikes with both weapons if dual wielding although with an accuracy and damage penalty.</ns1:description>
    <ns1:class rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Knight"/>
    <rdfs:comment xml:lang="en">Overhead Slash is an ability available to the Jedi Knight at level 4. It costs 5 focus, has a range of 4m and a cooldown of 6 seconds.

</rdfs:comment>
  </rdf:Description>
