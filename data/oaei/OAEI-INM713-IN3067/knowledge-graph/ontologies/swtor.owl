    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Elara Dorne</rdfs:label>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Elara Dorne</ns1:name>
    <ns5:abstract xml:lang="en">Elara Dorne is the second Companion Character for the Trooper. She joins the player at the end of the Trooper’s Class quests on Taris. Her primary role is that of a healer, and she is a romance option for the male Trooper.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Havoc_Squad"/>
