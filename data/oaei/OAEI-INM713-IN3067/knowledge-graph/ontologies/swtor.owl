    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/forkedlightning.png"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Forked Lightning</ns4:altLabel>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Forked Lightning</ns1:name>
