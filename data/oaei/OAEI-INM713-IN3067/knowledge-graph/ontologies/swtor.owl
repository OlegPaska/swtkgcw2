    <ns1:mission6difficultyyellow rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:mission6difficultyyellow>
    <ns1:mission3description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Senator from the tiny planet of Doan was assassinated. Send you companion to investigate the crime and find your who was involved.</ns1:mission3description>
    <ns1:mission3cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">285</ns1:mission3cost>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</ns1:level>
    <ns1:mission2type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bountiful</ns1:mission2type>
    <ns1:mission2yield rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Grade 1 Researched Compounds</ns1:mission2yield>
    <ns1:mission5description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Waskiro colony suddenly lost contact with the rst of the Republic. Send your companion to determine what could have silence it so swiftly.</ns1:mission5description>
    <ns1:mission2difficultyyellow rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:mission2difficultyyellow>
    <ns1:mission2difficultygrey rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">?</ns1:mission2difficultygrey>
