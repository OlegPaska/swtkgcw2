  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Onderon">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Inner_Rim_Planets"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onderon</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onderon</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onderon's</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Freedon_Nadd"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Onderon.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Onderon.jpg"/>
    <rdfs:comment xml:lang="en">One of eight worlds in the Japrael system - which was found within the Japrael sector of the Inner Rim - Onderon was a focal point of galactic politics from the time of the Freedon Nadd uprising in 4,400 BBY up to the end of the Sith Civil War in 3,950 BBY.</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Planets"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Planets"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Onderon.jpg?width=300"/>
    <ns5:abstract xml:lang="en">One of eight worlds in the Japrael system - which was found within the Japrael sector of the Inner Rim - Onderon was a focal point of galactic politics from the time of the Freedon Nadd uprising in 4,400 BBY up to the end of the Sith Civil War in 3,950 BBY.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Inner_Rim_Planets"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Inner_Rim_Territories"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onderon</rdfs:label>
  </rdf:Description>
