  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Rebuilding_the_Jedi_Order">
    <ns5:abstract xml:lang="en">This lore can be found on Tython. 
X:-427, Y:-508 This lore object is located inside the Jedi Temple on Tython. On the first floor of the building, take the second coridor on the right. Now enter the first room on the left, there will be a clickable chair. 

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
