    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Aurek-class_tactical_strikefighter"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Battle_of_Serroco"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Republic_Navy"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Centurion-class_battlecruiser"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Starship#Dreadnought"/>
    <ns1:passengers rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2000</ns1:passengers>
    <ns1:armament rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dual Turbolaser cannons</ns1:armament>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Diligence"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Indefatigable"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">''Inexpugnable''-class tactical command ship</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lore/Starships"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tremendous"/>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Command Ship</ns1:role>
    <rdfs:comment xml:lang="en">The Inexpugnable-class tactical command ship is a dreadnought that has been used by the Galactic Republic during the Mandalorian Wars. Due to its many weaknesses, only six of the command ships were made and soon they were phased out of the Republic Navy completely and replaced with the Centurion-class battlecruiser.

</rdfs:comment>
