    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Harkun"/>
    <ns1:prereqs rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">none</ns1:prereqs>
    <ns1:next rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Plight_of_the_Acolyte"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Inquisitors"/>
    <ns1:experience rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1095</ns1:experience>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Korriban"/>
    <rdfs:comment xml:lang="en">This is the first story mission given to the Sith Inquisitor, received upon arriving on Korriban.
The Player is given this quest right after the intro cinematic where they meet Harkun who will be the Overseer of their progress as Sith Acolytes. Harkun sends the Player on the first Trial of their training which is to speak to an old hermit called Spindrall and get his approval.

</rdfs:comment>
    <ns5:abstract xml:lang="en">This is the first story mission given to the Sith Inquisitor, received upon arriving on Korriban.
The Player is given this quest right after the intro cinematic where they meet Harkun who will be the Overseer of their progress as Sith Acolytes. Harkun sends the Player on the first Trial of their training which is to speak to an old hermit called Spindrall and get his approval.

</ns5:abstract>
