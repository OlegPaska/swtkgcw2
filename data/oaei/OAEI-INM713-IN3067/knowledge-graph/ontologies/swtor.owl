  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Explosive_Round">
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Damage</ns1:role>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Explosive Round</ns1:link>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Explosive_Round_Icon.png"/>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ammo</ns1:resource>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:cooldown>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Explosive Round</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Explosive Round</ns5:wikiPageWikiLinkText>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Explosive Round</ns1:name>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Explosive Round Icon.png</ns1:icon>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fires a heavy round that deals 1664-1791 kinetic damage to the primary target and 800-927 kinetic damage to up to 7 standard or weak targets within 5 meters of the primary target.  If the primary target is a weak or standard enemy, it is knocked to the ground.</ns1:description>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Explosive Round</rdfs:label>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Explosive_Round_Icon.png?width=300"/>
    <ns1:cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</ns1:cost>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:range>
    <ns1:activation rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:activation>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Iziz">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Iziz</rdfs:label>
    <rdfs:comment xml:lang="en">Iziz is a massive, walled city and the only modern settlement on the planet Onderon, serving as the Japrael system's capital. Ruled by a popular monarchy, the cities defenses were devoted to keeping out the flying beasts which attacked the planet from the nearby moon of Dxun.</rdfs:comment>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/expand"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Iziz</ns4:altLabel>
    <ns5:abstract xml:lang="en">Iziz is a massive, walled city and the only modern settlement on the planet Onderon, serving as the Japrael system's capital. Ruled by a popular monarchy, the cities defenses were devoted to keeping out the flying beasts which attacked the planet from the nearby moon of Dxun.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dxun"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Iziz</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Onderon"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Isric.png"/>
  </rdf:Description>
