  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_nexus">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Valley_of_the_Dark_Lords"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Korriban"/>
    <ns5:abstract xml:lang="en">Force nexus is a term used to refer to any location where the Force, or any particular aspect of the Force, was unusually strong. Such nexuses could be caused by any number of different events. Korriban in general and the Valley of the Dark Lords specifically are nexuses of the Dark Side of the Force due to the long-term presence of the Sith Lords.</ns5:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force nexus</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">nexus</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">Force nexus is a term used to refer to any location where the Force, or any particular aspect of the Force, was unusually strong. Such nexuses could be caused by any number of different events. Korriban in general and the Valley of the Dark Lords specifically are nexuses of the Dark Side of the Force due to the long-term presence of the Sith Lords.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force nexus</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:The_Force"/>
