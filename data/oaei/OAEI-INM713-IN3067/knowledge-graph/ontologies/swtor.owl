    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bombers"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/D-5_Decimus.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Galactic_Starfighter"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/B-4D_Legion"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">D-5 Decimus</ns5:wikiPageWikiLinkText>
    <ns1:manufacturer rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">shipyards</ns1:manufacturer>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Imperial_Navy"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bomber</ns1:type>
    <ns5:abstract xml:lang="en">The D-5 Decimus is a bomber used by the Sith Empire. The D-5 is similar in appearance to its cousins the B-4D Legion and the M-7 Razorwire, it however, is smaller and possesses vertical wing-panels. The D-5 is armed with laser cannons and bombs to level enemy fortifications and cities.


</ns5:abstract>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns1:crew rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:crew>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">D-5 Decimus</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Starships"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/starship"/>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bomder</ns1:role>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/D-5_Decimus.png"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">D-5 Decimus</ns1:name>
    <rdfs:comment xml:lang="en">The D-5 Decimus is a bomber used by the Sith Empire. The D-5 is similar in appearance to its cousins the B-4D Legion and the M-7 Razorwire, it however, is smaller and possesses vertical wing-panels. The D-5 is armed with laser cannons and bombs to level enemy fortifications and cities.


</rdfs:comment>
