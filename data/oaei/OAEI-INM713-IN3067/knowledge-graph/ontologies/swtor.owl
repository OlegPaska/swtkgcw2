    <ns1:speed rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unknown</ns1:speed>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/SGS-41B_Comet_Breaker.jpg"/>
