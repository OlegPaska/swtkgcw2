  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Three_Families">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Three Families</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Organizations"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Three_Families.jpg?width=300"/>
    <ns1:secondary rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kabbura"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jeelta_Urdosh"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Three_Families"/>
    <ns1:headquarters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Quesh"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Hutts"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Broga_Masrii"/>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:abstract xml:lang="en">The Three Families was a group of Hutts that were based on Quesh. The families were: Masrii, Urdosh, and Kaltemmic. They were led by Broga Masrii, Portho Kaltemmic, and Jeelta Urdosh. At some point, Kabbura joined the families.
Portho allied himself and the Kaltemmic family with the Sith Empire during the Quesh War, resulting in Broga and Jeelta to ally with the Galactic Republic and the Hutt Cartel. Ultimately, Portho and Jeelta were killed, leaving Broga to lead the Three Families.

</ns5:abstract>
    <ns1:leader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Broga_Masrii"/>
    <ns1:leader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jeelta_Urdosh"/>
    <ns1:leader rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Portho_Kaltemmic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Quesh"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Three Families</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Three Families</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Organizations"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Three_Families.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Quesh"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Portho_Kaltemmic"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Three Families</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hutt"/>
    <rdfs:comment xml:lang="en">The Three Families was a group of Hutts that were based on Quesh. The families were: Masrii, Urdosh, and Kaltemmic. They were led by Broga Masrii, Portho Kaltemmic, and Jeelta Urdosh. At some point, Kabbura joined the families.
Portho allied himself and the Kaltemmic family with the Sith Empire during the Quesh War, resulting in Broga and Jeelta to ally with the Galactic Republic and the Hutt Cartel. Ultimately, Portho and Jeelta were killed, leaving Broga to lead the Three Families.

</rdfs:comment>
