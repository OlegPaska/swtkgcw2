  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_(Gameplay)">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Advanced_Classes"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex/Lore"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Abilities"/>
    <rdfs:comment xml:lang="en">A large part of Star Wars: The Old Republic involves player characters engaging in conflict with NPCs (PVE) or other player characters (PVP). The specific separate enagement that maybe occur between one or more player characters or NPCs, typically resolved by reducing characters health to 0, or until they surrender, is referred to as Combat.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat (Gameplay)</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Classes"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/tocright"/>
    <ns5:abstract xml:lang="en">A large part of Star Wars: The Old Republic involves player characters engaging in conflict with NPCs (PVE) or other player characters (PVP). The specific separate enagement that maybe occur between one or more player characters or NPCs, typically resolved by reducing characters health to 0, or until they surrender, is referred to as Combat.

</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Colicoid_war_game.jpg"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat (Gameplay)</rdfs:label>
  </rdf:Description>
