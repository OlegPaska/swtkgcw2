    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Force_powers"/>
    <rdfs:comment xml:lang="en">Force Whirlwind is a Force power in which the character uses the Force to create a spinning wind around the target. It effectively kept the target from counterattacking for a few turns.

</rdfs:comment>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/wookieepedia"/>
    <ns5:abstract xml:lang="en">Force Whirlwind is a Force power in which the character uses the Force to create a spinning wind around the target. It effectively kept the target from counterattacking for a few turns.

</ns5:abstract>
  </rdf:Description>
