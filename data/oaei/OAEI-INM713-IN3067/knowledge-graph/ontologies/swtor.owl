  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Drelliad">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Trooper"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Smugglers"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Drelliad</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Take_Back_Drelliad_Village"/>
    <ns1:row1Info rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ord_Mantell"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Landing_Party"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Smugglers"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ord_Mantell_Drelliad_Village.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Smuggler"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Drelliad_Spaceport"/>
    <rdfs:comment xml:lang="en">Drelliad is a village on Ord Mantell. It is the first village that the Trooper &amp; Smuggler visits during the game. The village is in a dilapidated state due to the fighting that has occurred there. It is currently under siege by the Separatists and the Ord Mantell Government is trying to recapture the village. Although the village is small, it does have its own spaceport, the Drelliad Spaceport.

</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ord_Mantell"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Clearing_the_Air"/>
    <ns5:abstract xml:lang="en">Drelliad is a village on Ord Mantell. It is the first village that the Trooper &amp; Smuggler visits during the game. The village is in a dilapidated state due to the fighting that has occurred there. It is currently under siege by the Separatists and the Ord Mantell Government is trying to recapture the village. Although the village is small, it does have its own spaceport, the Drelliad Spaceport.

</ns5:abstract>
