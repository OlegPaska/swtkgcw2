  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_Leadership:_Mark_II">
    <ns1:repeatable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">No</ns1:repeatable>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tython"/>
    <ns1:previous rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_Leadership_:_Mark_I"/>
    <ns1:start rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Liam_Dentiri"/>
    <ns1:experience rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1018</ns1:experience>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_Leadership_:_Mark_III"/>
    <ns1:end rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Liam_Dentiri"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Tython"/>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Regular</ns1:type>
    <ns5:abstract xml:lang="en">Liam Dentiri instructs the many Padawans on Tython in physical combat. He has pre-programmed several combat scenarios to test your skills and abilities in battle and has offered you a chance to prove yourself. You have successfully completed the first scenario, and Liam has urged you to try a second, more challenging one. Find one of the training consoles around the Jedi Temple courtyard, activate it, and complete the training scenario.

</ns5:abstract>
