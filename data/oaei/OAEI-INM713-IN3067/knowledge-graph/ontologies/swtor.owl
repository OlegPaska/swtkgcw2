  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nercathi_clan">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nercathi clan</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jasshi%27rr"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Twi%27lek"/>
    <rdfs:comment xml:lang="en">The Nercathi clan is a Twi'lek family on Ryloth dating at least as far back as the Dark Age of the Galactic Republic. Among its members was Jedi Lord Newar Forrth, the protector of Ryloth during the New Sith Wars. Following the death of Newar, clan members crafted three beautiful crystallite skulls to commemorate the Lord. Each skull represented one of the primary Twi'leki tenets - Jasshi'rr, Waala, and Keysshi.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Newar_Forrth"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ryloth"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Twi%27leks"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nercathi clan</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Lord"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Nemros-Palace.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Republic_Dark_Age"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nercathi clan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:abstract xml:lang="en">The Nercathi clan is a Twi'lek family on Ryloth dating at least as far back as the Dark Age of the Galactic Republic. Among its members was Jedi Lord Newar Forrth, the protector of Ryloth during the New Sith Wars. Following the death of Newar, clan members crafted three beautiful crystallite skulls to commemorate the Lord. Each skull represented one of the primary Twi'leki tenets - Jasshi'rr, Waala, and Keysshi.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Twi%27leks"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/New_Sith_Wars"/>
  </rdf:Description>
