  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/CZ_-_198">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/C86.jpg"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">CZ - 198</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cleanup"/>
    <ns5:abstract xml:lang="en">CZ - 198 is a location players who are Level 60 can go to to complete some Dailies and 1 Weekly to get some extra cash and commendations. It can be unlocked in your Legacy tab for 125 Cartel Coins or, if you don't want to or can't spend Cartel Coins, bought for 150,000 Credits, being Legacy Level 5 and your character being at least Level 50. It may also be accessed on the fleet near the phase where you enter your classes starship.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">CZ - 198</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">CZ - 198 is a location players who are Level 60 can go to to complete some Dailies and 1 Weekly to get some extra cash and commendations. It can be unlocked in your Legacy tab for 125 Cartel Coins or, if you don't want to or can't spend Cartel Coins, bought for 150,000 Credits, being Legacy Level 5 and your character being at least Level 50. It may also be accessed on the fleet near the phase where you enter your classes starship.</rdfs:comment>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">CZ - 198</ns4:altLabel>
  </rdf:Description>
