    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Reduces the cooldown of Concussive Round by [7.5 / 15] seconds and tech override by 15 seconds. In addition Tech Override has a [50 / 100]% chance of making your next 2 abilities with action time to active instantly.</ns1:description>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Passive</ns1:type>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Overclock</ns1:name>
    <ns1:cells rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cells>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
