  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Grenade">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Gunslinger"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Troopers"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">grenade</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Troopers"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Operative"/>
    <ns5:abstract xml:lang="en">A grenade is an explosive weapon that can be used by the Imperial Agent, Smuggler and Trooper classes, as well as the Commando, Gunslinger, Operative and Sniper advanced classes. Depending on the type of grenade used, they can either have offensive or crowd control effects.

</ns5:abstract>
    <ns5:wikiPageExternalLink rdf:resource="http://swtor.wikia.com/wiki/Trooper"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Equipment"/>
