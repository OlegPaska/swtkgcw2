  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Pit">
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Pit</ns1:name>
    <ns5:abstract xml:lang="en"> The Pit is a Hutt Cartel-owned battle arena housed on Nar Shaddaa. It is mainly used for a planet-wide spectical known as Huttball, a game of deadly ball throwing, gladitorial fighting and arena-wide carnage. 

</ns5:abstract>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/PitMap.jpg?width=300"/>
    <ns1:mapcaption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The arena's basic layout.</ns1:mapcaption>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Pit</ns5:wikiPageWikiLinkText>
