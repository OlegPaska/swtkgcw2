    <ns1:passengers rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Skytrooper"/>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Boarding</ns1:role>
