  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dar%27Nala">
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
