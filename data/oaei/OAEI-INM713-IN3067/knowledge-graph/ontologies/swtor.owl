    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Shoaneb_Culu_Starship.jpg"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shock Drum</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire_superweapons"/>
