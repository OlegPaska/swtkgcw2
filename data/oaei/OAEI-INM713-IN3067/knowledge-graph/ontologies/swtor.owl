  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kuat_Drive_Yards_(flashpoint)">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Fleet"/>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Len%27na_the_Stalker"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/AX-871"/>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Station_Guardian_One"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ns1:level>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Flashpoints"/>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Benes"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/KDY_flashpoint.jpg?width=300"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kuat Drive Yards (flashpoint)</ns5:wikiPageWikiLinkText>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jojun_the_Hunter"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Fleet"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Imperial_Flashpoints"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kuat Drive Yards</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Flashpoints"/>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Krupp"/>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Khoris"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Krupp"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Khoris"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jojun_the_Hunter"/>
    <ns1:caption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">For centuries, many of the galaxy’s largest and most powerful warships have been built by Kuat Drive Yards: a massive corporate complex of manufacturing plants and docks that form a ring around the planet Kuat. As a key part of the Republic war machine, Kuat Drive Yards has been one of the Empire’s primary targets for some time. Thanks to the strategies of the shrewd and ambitious Admiral Ranken, the time for an Imperial attack has finally come. However, Fleet Admiral Bey’wan Aygo, the Bothan leader of the Republic’s forces on Kuat, refuses to surrender such a critical war asset. The result is a fierce battle over control of Kuat that will see both factions calling on their greatest warriors to join the fray.</ns1:caption>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Republic_Flashpoints"/>
    <ns1:next rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:next>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Benes"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kuat Drive Yards (flashpoint)</ns4:altLabel>
    <rdfs:comment xml:lang="en">Kuat Drive Yards is a tactical flashpoint added with update 2.6. In this particular flashpoint, the players have augmented stats as level 55 characters.

</rdfs:comment>
    <ns1:encounters rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Modo"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/KDY_flashpoint.jpg"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Kovor_Ice_Field.jpg"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Kuat Drive Yards (flashpoint)</rdfs:label>
