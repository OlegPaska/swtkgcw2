  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bothan">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Bey%27wan_Aygo.png?width=300"/>
    <ns5:abstract xml:lang="en">Bothans were a short race of furry humanoids. Bothans differed in facial appearance and body structure with canine, feline, and equine features. They possessed tapered pointed ears, and both males and females were known to sport beards. They were known for being master politicians and spies, craving intrigue and subterfuge.

</ns5:abstract>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Bey%27wan_Aygo.png"/>
    <rdfs:comment xml:lang="en">Bothans were a short race of furry humanoids. Bothans differed in facial appearance and body structure with canine, feline, and equine features. They possessed tapered pointed ears, and both males and females were known to sport beards. They were known for being master politicians and spies, craving intrigue and subterfuge.

</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bothan</rdfs:label>
