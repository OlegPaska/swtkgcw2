  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Travi_Pott">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ord_Mantell"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Travi Pott</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Humans"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ord_Mantell"/>
    <ns5:abstract xml:lang="en">{{ #if: |
 Travi Pott was a human female who served the Galactic Republic during the Cold War against the Sith Empire. She was stationed on the planet Ord Mantell during the Separatist War against the Republic occupation. She lead a squad of Republic troops to Savrip Island to destroy a series of Separatist jamming beacons off the coast of Avialatan, but lost six men due to hazards and savrip attacks. She blamed her commanding officer for the loss of her men, and grew sarcastic trying to find a different method of accomplishing her task.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Republic_Army"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Republic_Military"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Travi_Pott.png?width=300"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Travi Pott</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Travi_Pott.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ord_Mantell"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ord_Mantell_Separatist_Movement"/>
