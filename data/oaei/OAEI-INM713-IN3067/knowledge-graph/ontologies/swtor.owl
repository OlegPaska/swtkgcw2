  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Nomi_Sunrider">
    <ns1:class rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Guardian_(Advanced_Class)"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Council"/>
