    <ns1:mission1description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">An eccentric old noble plans to leave his antiques-including a valuable hyperspace map-to the enemy. Your companion must blackmail him into changing his mind.</ns1:mission1description>
    <ns1:mission5type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Abundant</ns1:mission5type>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Diplomacy</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Crew_Skills"/>
