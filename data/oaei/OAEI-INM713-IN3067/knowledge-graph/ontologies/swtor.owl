    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Suppression</ns4:altLabel>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force In Balance now suppresses resistance to the Force, increasing the amount of damage the targets suffer from your next 15 periodic damaging abilities by 10%.  Lasts 30 seconds.</ns1:description>
