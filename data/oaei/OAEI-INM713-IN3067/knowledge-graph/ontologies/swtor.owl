  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Area_of_Effect">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Trooper"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Explosive_Round"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Consular"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Death_from_Above"/>
    <ns5:abstract xml:lang="en">Area of effect (AoE) is a term that is used to describe an ability that affects an area rather than just one singular target. Most Area of Effect abilities are targeted some AoE abilities can be placed by moving the mouse to where the ability wants to be used. area of effect abilities can also originate from the user's position and this area of effect abilities are referred to as point-blank area of effect (PBAoE).

</ns5:abstract>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Area of effect</ns4:altLabel>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Area of Effect</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bounty_Hunter"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Battles"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Archenar_Interception.png"/>
    <rdfs:comment xml:lang="en">Area of effect (AoE) is a term that is used to describe an ability that affects an area rather than just one singular target. Most Area of Effect abilities are targeted some AoE abilities can be placed by moving the mouse to where the ability wants to be used. area of effect abilities can also originate from the user's position and this area of effect abilities are referred to as point-blank area of effect (PBAoE).

</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Area of Effect</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Battles"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Wave"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Area of Effect</rdfs:label>
  </rdf:Description>
