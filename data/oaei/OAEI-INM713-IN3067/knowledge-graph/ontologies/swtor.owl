    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Overwhelming</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">When a creature or NPC with the Overwhelming ability attacks a target the target will receive the Slowed affect.


</rdfs:comment>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Buff</ns1:type>
