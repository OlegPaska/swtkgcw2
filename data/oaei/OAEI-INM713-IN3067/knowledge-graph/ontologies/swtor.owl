  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Bandon">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Fallen_Jedi"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/character-k"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/DarthArkous.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Malak"/>
    <ns1:location rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unknown</ns1:location>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire_(Jedi_Civil_War)"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Darth Bandon</rdfs:label>
    <ns1:voice rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Neil_Kaplan"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Jedi"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Apprentices"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Neil_Kaplan"/>
    <ns1:gender rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Male</ns1:gender>
    <ns1:race rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
    <ns5:abstract xml:lang="en">Darth Bandon was a former Jedi Padawan turned Sith apprentice of the Dark Lord of the Sith Darth Malak. He was sent by Malak to kill his former master Revan. Bandon was killed by Revan along with two Dark Jedi with Bandon at the time.

</ns5:abstract>
    <ns1:status rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Deceased</ns1:status>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Head_of_Darth_Bandon_(Smuggler)"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Lord_of_the_Sith"/>
