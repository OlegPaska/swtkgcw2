    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Droid_Project1.png?width=300"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Project</ns4:altLabel>
