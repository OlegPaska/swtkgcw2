  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sphere_of_Military_Strategy">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Military Strategy</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Imperial_Military"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Office of Military Strategy</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Council"/>
    <rdfs:comment xml:lang="en">The Sphere of Military Strategy was one of twelve Spheres of Influence of the Sith Empire. Headed by a Dark Councilor, the Sphere was responsible for the strategies and plans that allowed the Spheres of Military Offense and Defense of the Empire to lead the Imperial Military to victory. Darth Azamin was the head of the Sphere during the Great Galactic War, and he was succeeded by Darth Decimus during the Cold War.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Cold_War"/>
    <ns5:abstract xml:lang="en">The Sphere of Military Strategy was one of twelve Spheres of Influence of the Sith Empire. Headed by a Dark Councilor, the Sphere was responsible for the strategies and plans that allowed the Spheres of Military Offense and Defense of the Empire to lead the Imperial Military to victory. Darth Azamin was the head of the Sphere during the Great Galactic War, and he was succeeded by Darth Decimus during the Cold War.</ns5:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Military Strategy</ns5:wikiPageWikiLinkText>
