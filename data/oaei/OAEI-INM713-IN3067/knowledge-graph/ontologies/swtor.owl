  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Presence">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Statistics"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/2505.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Gameplay"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Presence</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Companions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Attributes"/>
    <rdfs:comment xml:lang="en">The presence stat increases companion health, damage, and healing, making it the ideal stat for soloing gear sets. It only works when equipped on your character. Equipping presence gear on a companion character does not apply the effect. 

</rdfs:comment>
