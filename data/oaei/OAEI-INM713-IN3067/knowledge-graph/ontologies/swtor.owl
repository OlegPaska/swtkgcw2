  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Vanguard_(starship)">
    <ns1:owners rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hylo_Visz"/>
