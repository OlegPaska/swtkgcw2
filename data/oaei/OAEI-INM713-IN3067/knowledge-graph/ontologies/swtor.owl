    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/hostagecleanupswtor.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Imperial_Agents"/>
    <ns1:repeatable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Yes</ns1:repeatable>
    <ns5:abstract xml:lang="en"> Hostage Situation Cleanup is a level 6 heroic mission available to bounty hunters and Imperial agents on Hutta. This mission is only available after the player completes the Hostage Situation mission first.

</ns5:abstract>
