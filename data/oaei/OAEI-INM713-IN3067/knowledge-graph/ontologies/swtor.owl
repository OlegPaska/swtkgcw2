    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Flesh_Raider"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Nalen Raloch</ns5:wikiPageWikiLinkText>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Nalen.jpg?width=300"/>
    <ns1:status rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Alive</ns1:status>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lightsaber"/>
    <ns1:species rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Twi%27lek"/>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</ns1:level>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Kaleth"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/republic_npc"/>
    <ns5:abstract xml:lang="en">Nalen Raloch was a Twi'lek male Force-sensitive warrior who lived on Tython during the Cold War. He was a crucial part in the survival of Kalikori Village during attacks by the Flesh Raiders. However, he preferred to stay isolated and grow strong, having stolen a Jedi teaching holocron to fuel his lust to kill everything that threatened his way of life.

</ns5:abstract>
