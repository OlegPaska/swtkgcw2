    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesenergy"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Scramble</ns4:altLabel>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
    <ns1:description rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">1.5</ns1:description>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Scoundrel</ns1:class>
    <ns1:energy rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:energy>
    <rdfs:comment xml:lang="en">Every time you get attacked, the active cooldown of your Dodge is reduced by 1.5 seconds]. This effect cannot occur more than once every 1.5 seconds.

</rdfs:comment>
