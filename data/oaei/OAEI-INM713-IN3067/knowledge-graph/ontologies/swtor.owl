    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mission_Skills"/>
    <ns1:mission5description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Many details of the Treaty of Coruscant remain classified to this day, but could shed some light on Republic and Imperial aims. Have your companion study the known data.</ns1:mission5description>
