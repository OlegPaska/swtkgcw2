    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Darth Nihilus</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/DNs.jpg"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Darth_Nihilus.jpg?width=300"/>
