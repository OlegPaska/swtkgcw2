  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Astromech_droid">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/X2-C3.png?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Droids"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/X2-C3.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/X2-C3_Imperial_astromech"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Astromech droid</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">astromech droid</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">An astromech droid, also often known as a utility droid, is a droid that serves generally as an automated mechanic. They are used to perform repairs, to communicate with computers and to hack into enemy computers by the player.

</ns5:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ash.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Droids"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:X2-C3.png"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Astromech droid</rdfs:label>
    <rdfs:comment xml:lang="en">An astromech droid, also often known as a utility droid, is a droid that serves generally as an automated mechanic. They are used to perform repairs, to communicate with computers and to hack into enemy computers by the player.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/T7-O1"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Astromech Droid</ns4:altLabel>
