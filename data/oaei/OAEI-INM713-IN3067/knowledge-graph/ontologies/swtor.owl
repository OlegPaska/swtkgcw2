  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sharp_Bomb">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sharp_Bomb.png"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/abilitiesenergy"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Sharp_Bomb.PNG"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Sharp_Bomb.png?width=300"/>
    <ns5:abstract xml:lang="en">Hurls a shrap bomb that explodes with razor-sharp shrapnel on impact, causing up to 5 targets within 5 meters to bleed for 3623 internal damage over 21 seconds.</ns5:abstract>
    <ns1:ctime rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:ctime>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Hurls a shrap bomb that explodes with razor-sharp shrapnel on impact, causing up to 5 targets within 5 meters to bleed for 3623 internal damage over 21 seconds.</ns1:description>
    <ns1:range rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">30m</ns1:range>
    <ns1:energy rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</ns1:energy>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Sharp_Bomb.PNG"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sharp Bomb</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Smuggler</ns1:class>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sharp Bomb</ns4:altLabel>
    <rdfs:comment xml:lang="en">Hurls a shrap bomb that explodes with razor-sharp shrapnel on impact, causing up to 5 targets within 5 meters to bleed for 3623 internal damage over 21 seconds.</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sharp Bomb</ns5:wikiPageWikiLinkText>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">N/A</ns1:cooldown>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sharp Bomb</ns1:name>
