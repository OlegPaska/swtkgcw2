  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mutant">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">mutant</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mutant</ns4:altLabel>
    <rdfs:comment xml:lang="en">A Mutant is an individual, organism, or new genetic character arising or resulting from an instance of mutation, which is a sudden structural change within the DNA of a gene or chromosome of an organism resulting in the creation of a new character or trait not found in the parental type.
</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mutant</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Lieutenant_Muir.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Force-sensitives"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:abstract xml:lang="en">A Mutant is an individual, organism, or new genetic character arising or resulting from an instance of mutation, which is a sudden structural change within the DNA of a gene or chromosome of an organism resulting in the creation of a new character or trait not found in the parental type.
In some cases, mutants were created through genetic engineering, radiation or the dark side of the Force, most notably Sith alchemy and magic. Subjects were often remade into mutants to be more brutal, more cunning, and, in some cases, more intelligent. In other cases, individuals of a wide range of species were born mutants most notably Triclops and the Keeramak.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Force-sensitives"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mutant</ns5:wikiPageWikiLinkText>
  </rdf:Description>
