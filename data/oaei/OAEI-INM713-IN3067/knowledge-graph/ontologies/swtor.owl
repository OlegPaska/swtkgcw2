  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dromund_Kaas_Citizen">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dromund Kaas Citizen</rdfs:label>
    <rdfs:comment xml:lang="en">{{ #if: |
Dromund Kaas Citizens can be seen throughout Dromund Kaas. Unlike most other NPCs, there are many of the same Dromund Kaas Citizens in the same area. However, they offer no missions or play any role besides wandering the streets.</rdfs:comment>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dromund Kaas Citizen</ns4:altLabel>
