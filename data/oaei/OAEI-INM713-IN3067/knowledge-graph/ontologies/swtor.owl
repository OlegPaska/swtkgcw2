  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_adept">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:The_Force"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force adept</ns5:wikiPageWikiLinkText>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force_Vitality.jpg"/>
    <ns5:abstract xml:lang="en">Force Adepts are Force-wielders of all species with varying powers and abilities. Some of these Force Adepts were known to wield Force weapons such as quarterstaffs imbued with the Force, which inflicted more damage and were able to withstand lightsaber blows. This generic concept of Force Adepts often depicted them with little to no formal Jedi training in the Force and often coming from primitive planets.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Quarterstaff"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force-sensitive"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_power"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_weapon"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Planets"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:The_Force"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force adept</rdfs:label>
    <rdfs:comment xml:lang="en">Force Adepts are Force-wielders of all species with varying powers and abilities. Some of these Force Adepts were known to wield Force weapons such as quarterstaffs imbued with the Force, which inflicted more damage and were able to withstand lightsaber blows. This generic concept of Force Adepts often depicted them with little to no formal Jedi training in the Force and often coming from primitive planets.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force adept</ns4:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://swtor.wikia.com/wiki/Special:FilePath/Shadows_and_Light.jpg?width=300">
    <ns2:rights rdf:resource="http://swtor.wikia.com/wiki/File:Shadows_and_Light.jpg"/>
