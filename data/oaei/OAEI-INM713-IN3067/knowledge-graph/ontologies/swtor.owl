  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Light_vs._Dark">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dark vs. Light</ns4:altLabel>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Dkjdi2.png"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Light vs. Dark</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Events"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dark vs. Light</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Light vs. Dark</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">The Light vs. Dark event, also known as the Dark vs. Light event, is an upcoming event in Star Wars: The Old Republic that focuses on the light side and dark side choices made by players during it's runtime to determine the state of the galaxy. The event is focused on new players with a hope to bring more people into the game rather than veteran players with lots of experience. Players can create new characters and complete objectives that provide exclusive rewards. 
</ns5:abstract>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Captain_Lieber.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Events"/>
    <rdfs:comment xml:lang="en">The Light vs. Dark event, also known as the Dark vs. Light event, is an upcoming event in Star Wars: The Old Republic that focuses on the light side and dark side choices made by players during it's runtime to determine the state of the galaxy. The event is focused on new players with a hope to bring more people into the game rather than veteran players with lots of experience. Players can create new characters and complete objectives that provide exclusive rewards. 
</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Light vs. Dark</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/main"/>
  </rdf:Description>
