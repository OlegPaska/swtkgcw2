    <ns1:row2Info rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Assembly Chamber</ns1:row2Info>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Assembly Chamber</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Infinite_Empire"/>
    <ns1:boxTitle rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Codex"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Coruscant"/>
