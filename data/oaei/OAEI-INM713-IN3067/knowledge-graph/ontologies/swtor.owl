    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dantooine Enclave Council</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Council"/>
    <ns1:members rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Bala_Nisi"/>
