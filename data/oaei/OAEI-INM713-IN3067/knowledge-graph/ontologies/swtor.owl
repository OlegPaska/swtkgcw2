    <rdfs:comment xml:lang="en">Increases the life redirected by Force In Balance and Serenity Strike and causes Sever Force and Force Technique's Force Breach effect to steal life from enemy targets, healing you for 25% of the damage they deal.
Level Granted : 52</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Psychic_Absorption.png"/>
    <ns1:cooldown rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:cooldown>
