    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Berooken's executive cruiser</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_The_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lore/Starships"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Codex"/>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Armed transport</ns1:role>
    <ns1:passengers rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Supreme_Chancellor"/>
    <rdfs:comment xml:lang="en">During the Great Galactic War, Supreme Chancellor Berooken made use of an executive cruiser to transport him and his entorage across the Galaxy. The cruiser was large, majestic and very luxurious. It was however, destroyed when the Sith Empire sacked Coruscant at the end of the war. 

</rdfs:comment>
