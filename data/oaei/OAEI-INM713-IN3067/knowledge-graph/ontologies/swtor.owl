    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:KotOR"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Elevator basket</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:abstract xml:lang="en">Elevator baskets were basic elevators used on Kashyyyk for travel to and from the Shadowlands. They were generally manned by Wookiees and rarely used by offworlders.

</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Wookiees"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Elevator basket</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Wookiees"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Wookiee"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Elevator basket</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/ElementofSurprise.png"/>
    <rdfs:comment xml:lang="en">Elevator baskets were basic elevators used on Kashyyyk for travel to and from the Shadowlands. They were generally manned by Wookiees and rarely used by offworlders.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Shadowlands"/>
  </rdf:Description>
