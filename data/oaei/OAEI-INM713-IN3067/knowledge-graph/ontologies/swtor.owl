    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Sap Strength</ns1:link>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Targets stunned by your Electrocute suffer Sapped Strength when Electrocute wears off, which reduces all damage dealt by 25% for 10 seconds.</ns1:description>
