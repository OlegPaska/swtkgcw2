  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Meditation">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Force"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Meditation</ns5:wikiPageWikiLinkText>
    <ns5:abstract xml:lang="en">Meditation is a starting ability of the Jedi Consular. It is the out of combat self-heal for the Consular class. Meditation allows the Consular to regenerate both Force and Health, allowing the player to return to the fight in a shorter amount of time than would otherwise be the case.
Meditation does not cost any force, does not have a casting time and does not have a cooldown.
</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Meditation</rdfs:label>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Meditation</ns4:altLabel>
    <rdfs:comment xml:lang="en">Meditation is a starting ability of the Jedi Consular. It is the out of combat self-heal for the Consular class. Meditation allows the Consular to regenerate both Force and Health, allowing the player to return to the fight in a shorter amount of time than would otherwise be the case.
Meditation does not cost any force, does not have a casting time and does not have a cooldown.
</rdfs:comment>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:AbilitiesToRewrite"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">meditated</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Consular"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Medical_Probe.png"/>
  </rdf:Description>
