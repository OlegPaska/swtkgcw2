  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Keenor">
    <ns1:race rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
