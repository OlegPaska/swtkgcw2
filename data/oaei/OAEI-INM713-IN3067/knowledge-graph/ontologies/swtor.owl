  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Yuka_Laka">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Ithorians"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Yuka Laka</ns4:altLabel>
    <ns5:abstract xml:lang="en">Yuka Laka was a male Ithorian, who owned a small droid/droid parts shop in Anchorhead, Tatooine. He received HK-47 as a payment for a debt owed to him, and later sold it to Revan.


</ns5:abstract>
