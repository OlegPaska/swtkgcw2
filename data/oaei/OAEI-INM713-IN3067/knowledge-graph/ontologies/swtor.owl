  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ability:Force_Leech">
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Damage</ns1:role>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Force Leech</ns1:link>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Steals life from an enemy, dealing 2230-2358 internal damage to the target and healing you for 50% of the damage dealt.</ns1:description>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force_Leech.png"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Force Leech</rdfs:label>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Force Leech.png</ns1:icon>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">12.0</ns1:cooldown>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</ns1:cost>
    <ns1:activation rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">1.5</ns1:activation>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
