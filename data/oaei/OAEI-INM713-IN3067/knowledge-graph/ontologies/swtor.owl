  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Senate_Tower">
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Senate_Building.png"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/quote"/>
