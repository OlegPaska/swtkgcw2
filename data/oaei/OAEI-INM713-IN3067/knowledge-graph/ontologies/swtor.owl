  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Offshoot">
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Offshoot</rdfs:label>
    <rdfs:comment xml:lang="en">Offshoots were a genetically engineered sub-species of the Arkanian race. Offshoots were designed to be laborers and differed from their parent species by having human-like hands and eyes, white skin and hair, a weaker immune system and shorter lifespan.
The exact level of rights Offshoots had in Arkanian society shifted over the years. By the time of the Mandalorian Wars Offshoots could not attend universities and were kept confined to camps on their homeworld of Arkania. Offshoots who were able to carve out lives for themselves in the Galactic Republic were considered fortunate.</rdfs:comment>
    <ns1:allegiance rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Offshoot.jpg?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Wars"/>
    <ns1:playable rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">No</ns1:playable>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Human"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Arkanian"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Offshoot</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Arkania"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Offshoot.jpg"/>
    <ns1:homeworld rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Arkania"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/species"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Offshoot</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Offshoot.jpg"/>
    <ns5:abstract xml:lang="en">Offshoots were a genetically engineered sub-species of the Arkanian race. Offshoots were designed to be laborers and differed from their parent species by having human-like hands and eyes, white skin and hair, a weaker immune system and shorter lifespan.
The exact level of rights Offshoots had in Arkanian society shifted over the years. By the time of the Mandalorian Wars Offshoots could not attend universities and were kept confined to camps on their homeworld of Arkania. Offshoots who were able to carve out lives for themselves in the Galactic Republic were considered fortunate.</ns5:abstract>
  </rdf:Description>
