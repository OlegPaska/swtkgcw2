  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sphere_of_Technology">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Hadra"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Spheres_of_Influence"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Darth_Mekhis"/>
    <ns5:abstract xml:lang="en">The Sphere of Technology was one of twelve Spheres of Influence of the Sith Empire. Headed by a Dark Councilor, the Pyramid was responsible for the scientific advancement of the Empire. After Darth Mekhis' death, Darth Hadra took her place at the head of the Pyramid, and also presided over Dromund Kaas itself.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Spheres_of_Influence"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Technology</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Sith_Empire"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Chiss.jpg"/>
    <rdfs:comment xml:lang="en">The Sphere of Technology was one of twelve Spheres of Influence of the Sith Empire. Headed by a Dark Councilor, the Pyramid was responsible for the scientific advancement of the Empire. After Darth Mekhis' death, Darth Hadra took her place at the head of the Pyramid, and also presided over Dromund Kaas itself.</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Dark_Council"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Technology</ns4:altLabel>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sphere of Technology</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Spheres_of_Influence"/>
  </rdf:Description>
