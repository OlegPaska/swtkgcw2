  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Tech_Commando">
    <ns1:title rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Tech Commando</ns1:title>
    <ns1:faction rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Clan_Varad"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Mandalorian_Tech_Commando.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mandalorian_Raiders"/>
    <ns1:faction rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian"/>
    <ns1:location rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Mandalorian_Raiders"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Republic_Navy"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Mandalorian_Raiders"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns1:class rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rist Missle Tech</ns1:class>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</ns1:level>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Mandalorian Tech Commando</ns1:name>
    <rdfs:comment xml:lang="en">Mandalorian Tech Commandos were elite forces of Clan Varad during the Cold War. When Clan Varad stole the Republic warship Allusis, many of Mandalorian Tech Commandos and Mandalorian Fire Commandos were on board. When the Galactic Republic and Sith Empire fought for the Allusis, many of these Commandos were killed during the fighting.

</rdfs:comment>
