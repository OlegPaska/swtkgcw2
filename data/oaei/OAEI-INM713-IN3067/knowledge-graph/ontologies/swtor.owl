    <ns1:side rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">First Battle of Bothawui</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Battles"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/300px-Bothawui_2.jpg"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Battle of Bothawui</ns1:name>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">First Battle of Bothawui</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">First</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Sith_Empire"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Great_Galactic_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:300px-Bothawui_2.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Battles"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:802px-1st_battle_of_Bothawui_GGW.jpg"/>
    <rdfs:comment xml:lang="en">The First Battle of Bothawui was a one of the first major victories for the Galactic Republic in the Great Galactic War which saw them successfully defeat an Imperial invasion force, preventing it from even landing on the planet. The result of the battle meant the Empire sent in reinforcment setting the stage for another battle.


</rdfs:comment>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Battle of Bothawui (first)</ns4:altLabel>
    <ns1:side rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns1:place rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bothawui</ns1:place>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Harrower-class_dreadnought"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Great_Galactic_War"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/802px-1st_battle_of_Bothawui_GGW.jpg?width=300"/>
    <ns5:abstract xml:lang="en">The First Battle of Bothawui was a one of the first major victories for the Galactic Republic in the Great Galactic War which saw them successfully defeat an Imperial invasion force, preventing it from even landing on the planet. The result of the battle meant the Empire sent in reinforcment setting the stage for another battle.


</ns5:abstract>
