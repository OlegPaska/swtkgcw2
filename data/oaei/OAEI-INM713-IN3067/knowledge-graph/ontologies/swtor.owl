  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Unassembled_Champion_Token">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:PvP"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unassembled Champion Token</ns4:altLabel>
    <ns5:abstract xml:lang="en">The Unassembled Champion tokens can be found in Champion Gear Bags. They can be turned in to your class PVP Champion Vendor for the corresponding item. For example, an Unassembled Champion Frontline Force Headgear token can buy the Vindicator, War Leader, or Weaponmaster helmet.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Unassembled Champion Token</rdfs:label>
