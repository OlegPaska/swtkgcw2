  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Short_lightsaber">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lightsabers"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Shortsaber.png?width=300"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/quote"/>
    <rdfs:comment xml:lang="en">A short lightsaber, as it's name suggests, is a lightsaber with a diminished blade and hilt length. They were often used in the off-hand during two-weapon fighting, and were popular with Dark Jedi during the Jedi Civil War.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Civil_War"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars_Knights_of_the_Old_Republic_II:_The_Sith_Lords_items"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Short lightsaber</rdfs:label>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic_items"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Shortsaber.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Weapons"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Short lightsaber</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Lightsabers"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic_items"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Shortsaber.png"/>
    <ns5:abstract xml:lang="en">A short lightsaber, as it's name suggests, is a lightsaber with a diminished blade and hilt length. They were often used in the off-hand during two-weapon fighting, and were popular with Dark Jedi during the Jedi Civil War.

</ns5:abstract>
