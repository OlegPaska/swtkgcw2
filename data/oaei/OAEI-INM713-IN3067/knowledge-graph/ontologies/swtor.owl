  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Vulkar_Base">
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_Knights_of_the_Old_Republic"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lower_City"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar Base</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Undercity_Sewers"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">based</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Hidden_Bek_swoop_gang"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/wookieepedia"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Swoop_Accelerator"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Swoop_bike"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Black Vulkar Base</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Black_Vulkar_swoop_gang"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Taris"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Star_Wars:_Knights_of_the_Old_Republic"/>
    <rdfs:comment xml:lang="en">The Black Vulkar Base was the headquarters of the Black Vulkar swoop gang located in the Lower City of Taris. The base complex consisted of two levels. The main floor had an entrance to the streets of the Lower City, but also had an elevator to the upper level of the Undercity sewers. The lower garage floor was functioning as a mainteance bay for the Swoop bikes of the gang. The prototype Swoop accelerator that Vulkars stole from the rival Hidden Bek swoop gang was located in one of the rooms of garage floor.

</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Black_Talon.png"/>
    <ns5:abstract xml:lang="en">The Black Vulkar Base was the headquarters of the Black Vulkar swoop gang located in the Lower City of Taris. The base complex consisted of two levels. The main floor had an entrance to the streets of the Lower City, but also had an elevator to the upper level of the Undercity sewers. The lower garage floor was functioning as a mainteance bay for the Swoop bikes of the gang. The prototype Swoop accelerator that Vulkars stole from the rival Hidden Bek swoop gang was located in one of the rooms of garage floor.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Upper_Sewers"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
  </rdf:Description>
