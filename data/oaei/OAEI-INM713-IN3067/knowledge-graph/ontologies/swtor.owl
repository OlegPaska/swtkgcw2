    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/stub"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Trooper"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tactical Hunting Rifle</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blaster_Rifles"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tactical Hunting Rifle</ns5:wikiPageWikiLinkText>
    <rdfs:comment xml:lang="en">Tactical Hunting Rifle is a reward from the mission Clearing the Air. It is only equipable and usable if the player has the Blaster Rifle skill. It is the first major weapon upgrade for the Trooper.
</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Clearing_the_Air"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions/Rewards"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions/Rewards"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Blaster_Rifles"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Slots"/>
    <ns5:abstract xml:lang="en">Tactical Hunting Rifle is a reward from the mission Clearing the Air. It is only equipable and usable if the player has the Blaster Rifle skill. It is the first major weapon upgrade for the Trooper.
</ns5:abstract>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Energy">
    <ns5:abstract xml:lang="en">Energy is the smuggler's class energy pool. When there is low energy most abilities will not be able to be accessed. Energy can be recovered by Recuperation or waiting.
</ns5:abstract>
