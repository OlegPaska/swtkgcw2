    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Death_from_above.jpg"/>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death from Above</ns1:name>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rains death from above, firing a volley of missiles that deal 4219 kinetic damage over the duration to up to 8 enemies within the targeted area.  Standard and weak targets are knocked down by the blasts.  Generates 30 heat over the duration.</ns1:description>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Bounty_Hunters"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Death_from_above.jpg?width=300"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Heat</ns1:resource>
    <ns1:cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:cost>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Channeled</ns1:type>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Weapon_Damage">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <rdfs:comment xml:lang="en">Weapon Damage refers to whatever kind of damage a referenced or related weapon generates. Its often used in wording for tooltips. Typically, equipped weapons generate Engery Damage or Kinetic Damage. One of these is often the actual damage type involved when referred to by Weapon Damage. For further information on damage see Damage Types and Attack Types.</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Weapon Damage</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Damage_Types"/>
    <ns5:abstract xml:lang="en">Weapon Damage refers to whatever kind of damage a referenced or related weapon generates. Its often used in wording for tooltips. Typically, equipped weapons generate Engery Damage or Kinetic Damage. One of these is often the actual damage type involved when referred to by Weapon Damage. For further information on damage see Damage Types and Attack Types.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Game_Mechanics"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Placeholder.png"/>
