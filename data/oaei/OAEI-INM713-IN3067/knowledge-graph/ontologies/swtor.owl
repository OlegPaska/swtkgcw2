    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Pestilence.png</ns1:icon>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Pestilence</ns4:altLabel>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pestilence</ns1:name>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ability:Pestilence</ns1:link>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Death field spreads your Affliction and Creeping Terror to the targets it damages, as long as it damages targets already affected by Affliction and Creeping Terror.  In addition, Death Field overwhelms its targets for 45 seconds.  Overwhelmed targets take 10% more damage from area attacks.</ns1:description>
