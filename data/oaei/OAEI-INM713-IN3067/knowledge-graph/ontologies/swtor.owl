    <ns1:mission3description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">A deep space exploration vessel has returned from a journey outside the galactic rim, apparently empty. Have your companion retrieve its logs.</ns1:mission3description>
    <ns1:mission4cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">565</ns1:mission4cost>
    <ns1:mission1time rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">0.0</ns1:mission1time>
