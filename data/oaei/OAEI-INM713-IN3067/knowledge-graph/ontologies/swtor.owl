    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Rutian_by_laureril.jpg?width=300"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rutian</rdfs:label>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rutian</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Rutian_by_laureril.jpg"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Playable_species"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Twi%27leks"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Rutian_by_laureril.jpg"/>
    <ns5:abstract xml:lang="en">Rutian referred to one of the many skin tones of the Twi'lek species. Generally denoting a color somewhere between dark blue and aquamarine, of which other variations included teal and turquoise, this was among the rarest skin hues among Twi'leks, second only to the red-skinned Lethans.</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Species"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Lethan"/>
    <rdfs:comment xml:lang="en">Rutian referred to one of the many skin tones of the Twi'lek species. Generally denoting a color somewhere between dark blue and aquamarine, of which other variations included teal and turquoise, this was among the rarest skin hues among Twi'leks, second only to the red-skinned Lethans.</rdfs:comment>
  </rdf:Description>
