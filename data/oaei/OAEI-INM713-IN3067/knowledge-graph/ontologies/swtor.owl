    <ns1:mission5yield rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Rank 1 Companion Gifts</ns1:mission5yield>
    <ns1:mission2name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">One Man's Treasure</ns1:mission2name>
    <ns1:mission1yield rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Class 2 Lockboxes</ns1:mission1yield>
    <ns1:mission3cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">230</ns1:mission3cost>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Crew_Skills"/>
