  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Demolition_Round">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Demolition Round</ns5:wikiPageWikiLinkText>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation</ns1:type>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Demolition Round</ns1:link>
    <ns1:activation rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Instant</ns1:activation>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:range>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ammo</ns1:resource>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">15.0</ns1:cooldown>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Demolition_Round.png?width=300"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Demolition_Round.png"/>
    <ns1:cost rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ns1:cost>
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Damage</ns1:role>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Demolition Round</ns4:altLabel>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Demolition_Round.PNG</ns1:icon>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Demolition Round</ns1:name>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Demolition Round</rdfs:label>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fires a demolition round that explodes on contact, dealing 2863-2991 kinetic damage.  This damage is increased by 25% if the target is affected by your gravity vortex.</ns1:description>
  </rdf:Description>
