    <rdfs:comment xml:lang="en">Players can now use the command /roll or /random to generate a random number between 1 and 100. This command will also accept a range (example: /roll 20-40) or a die value (example: 2d6).

</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Am-Ris.jpg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Patch 1.1.5</ns4:altLabel>
    <ns5:abstract xml:lang="en">Players can now use the command /roll or /random to generate a random number between 1 and 100. This command will also accept a range (example: /roll 20-40) or a die value (example: 2d6).

</ns5:abstract>
  </rdf:Description>
