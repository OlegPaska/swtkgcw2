    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:NPCs"/>
    <ns5:abstract xml:lang="en">Geric was a old man located on Hutta with a problem with his lungs. Upon speaking with him he gives you a Heroic Mission and asks for your help in purifying the river.</ns5:abstract>
