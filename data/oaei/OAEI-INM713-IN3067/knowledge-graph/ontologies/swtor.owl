  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_battlemaster">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Military_Ranks"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Temple_Ruins"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Military_Ranks"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Council"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Galactic_Republic"/>
    <ns5:abstract xml:lang="en">Jedi Battlemaster (or Jedi Sword Master) is the title for the premier lightsaber combat instructor of the Jedi Order's Jedi academy. Appointed by the Jedi High Council, the Battlemaster oversaw all lightsaber instruction at the academy, and was responsible for electing new instructors. While there was only one Battlemaster at any given time following the Ruusan Reformations of the Galactic Republic, the Order's satellite academies each received a respective head instructor, all of whom reported to and were hand-picked by the Battlemaster of the Jedi Order on Coruscant.</ns5:abstract>
    <rdfs:comment xml:lang="en">Jedi Battlemaster (or Jedi Sword Master) is the title for the premier lightsaber combat instructor of the Jedi Order's Jedi academy. Appointed by the Jedi High Council, the Battlemaster oversaw all lightsaber instruction at the academy, and was responsible for electing new instructors. While there was only one Battlemaster at any given time following the Ruusan Reformations of the Galactic Republic, the Order's satellite academies each received a respective head instructor, all of whom reported to and were hand-picked by the Battlemaster of the Jedi Order on Coruscant.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi battlemaster</rdfs:label>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/WatchmanAtris.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_instructor"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Coruscant"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Ruusan_Reformation"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Jedi battlemaster</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Jedi_Order"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Order"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Force_Lightning">
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Damage</ns1:role>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Darth_Nihilus_the_Dark_Lord.jpg"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/forcelightning1.jpg"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force-Lighting.jpg?width=300"/>
    <ns5:abstract xml:lang="en">For information on this subject beyond The Old Republic, see: Force lightning on Wookieepedia


</ns5:abstract>
    <ns1:link rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Lightning</ns1:link>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Lightning.png?width=300"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">purple Lightning</ns5:wikiPageWikiLinkText>
    <ns1:resource rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:resource>
    <ns1:range rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</ns1:range>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Force-Lighting.jpg"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Deals 4035 energy damage to the target and consumes 40 Force over the duration of the channel.  Also slows the movement speed of the target by 50% and immobilizes weak and standard enemies.</ns1:description>
    <ns1:channel rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">3.0</ns1:channel>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/forcelightning1.jpg?width=300"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Lightning</rdfs:label>
    <ns1:name rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Lightning</ns1:name>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Darth_Nihilus_the_Dark_Lord.jpg?width=300"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">crackling bolts of energy</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">swirling storm</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Lightning</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/forcelightning2.jpg"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/forcelightning2.jpg?width=300"/>
    <ns1:cooldown rdf:datatype="http://dbkwik.webdatacommons.org/datatype/second">6.0</ns1:cooldown>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Ability_Force_Lightning.png"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Force Lightning</ns4:altLabel>
    <ns1:icon rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">File:Ability Force Lightning.png</ns1:icon>
    <rdfs:comment xml:lang="en">For information on this subject beyond The Old Republic, see: Force lightning on Wookieepedia


</rdfs:comment>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Channeled</ns1:type>
