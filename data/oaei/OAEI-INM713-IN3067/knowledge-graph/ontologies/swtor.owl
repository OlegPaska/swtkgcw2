    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Corragut</ns4:altLabel>
    <ns5:abstract xml:lang="en">The Corragut are a sentient species native to the planet Altawar, in the Corellian sector of the Core Worlds. Together with the Nosaurians of New Plympto and the Frozians of Froz, the Corragut were treated as a client species by the Corellians.</ns5:abstract>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Species"/>
  </rdf:Description>
