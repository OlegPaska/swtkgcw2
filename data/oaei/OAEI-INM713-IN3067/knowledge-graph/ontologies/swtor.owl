  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Combat_Leadership_:_Mark_I">
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat Leadership : Mark I</ns4:altLabel>
    <rdfs:comment xml:lang="en">Liam Dentiri instructs many padawans on Tython in physical combat. He has preprogrammed several combat scenarios to test your skills and abilities in battle and has offered you a chance to prove yourself. You must first activate his droids to begin the scenario.Find one of the training consoles around the Jedi Temple courtyard, activate it, and complete the training scenario.

</rdfs:comment>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Colicoid_war_game.jpg"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/cost"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Combat Leadership : Mark I</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Tython"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Jedi_Temple_(Tython)"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Missions"/>
    <ns5:abstract xml:lang="en">Liam Dentiri instructs many padawans on Tython in physical combat. He has preprogrammed several combat scenarios to test your skills and abilities in battle and has offered you a chance to prove yourself. You must first activate his droids to begin the scenario.Find one of the training consoles around the Jedi Temple courtyard, activate it, and complete the training scenario.

</ns5:abstract>
