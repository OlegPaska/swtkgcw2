  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/The_Coast_of_Denova">
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Coast of Denova</ns5:wikiPageWikiLinkText>
    <ns1:location rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Denova</ns1:location>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Novare_Coast"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1337428569_novare_coast_01.jpg"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Warzones"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Coast of Denova</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzones"/>
    <ns5:abstract xml:lang="en">The Denova Coast is the most contested battlezone on the planet Denova. Both Republic and Imperial forces have taken control over the rest of the planet, and now all that's left is the coast of Novare. Whoever takes control of the beach will have control of the most ground on the planet, so the fighting here is the most important to Denova's future.

</ns5:abstract>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzone_Arenas"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Locations"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:PvP"/>
    <ns1:inhabitants rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Players</ns1:inhabitants>
    <ns1:type rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Warzone Arena</ns1:type>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/1337428569_novare_coast_01.jpg?width=300"/>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Map_pvp_denova_main_r.png"/>
    <ns1:caption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The mortar turrets need to be controlled at all costs.</ns1:caption>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/location"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:PvP"/>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzone_Arenas"/>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Map_pvp_denova_main_r.png?width=300"/>
    <rdfs:comment xml:lang="en">The Denova Coast is the most contested battlezone on the planet Denova. Both Republic and Imperial forces have taken control over the rest of the planet, and now all that's left is the coast of Novare. Whoever takes control of the beach will have control of the most ground on the planet, so the fighting here is the most important to Denova's future.

</rdfs:comment>
    <ns1:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</ns1:level>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Warzones"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Coast of Denova</rdfs:label>
    <ns1:mapcaption rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The terrain around the turrets prevents much escape.</ns1:mapcaption>
    <ns1:name rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Novare_Coast"/>
  </rdf:Description>
