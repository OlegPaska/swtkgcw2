    <ns1:passengers rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">None</ns1:passengers>
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/STAP.png?width=300"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Repulsorcraft"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Vehicles"/>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/vehicle"/>
