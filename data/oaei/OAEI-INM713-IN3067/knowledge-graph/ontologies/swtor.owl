  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Surrender">
    <rdfs:comment xml:lang="en">Surrender is an ability available to the Smuggler at level 24. It causes the smuggler's threat level to drop towards all currently engaged enemies. It costs no energy, is instant cast and has a 30 second cooldown.
</rdfs:comment>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Drastically reduces player threat level. Does not cause player to leave combat.</ns1:description>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Surrender_Icon.jpg"/>
    <ns1:icon rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Surrender_Icon.jpg"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Surrender</rdfs:label>
