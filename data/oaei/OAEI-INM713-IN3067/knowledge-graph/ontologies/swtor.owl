  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Forked_Lightning">
    <ns1:role rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supporting</ns1:role>
    <rdf:type rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/class/ability"/>
    <ns1:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lightning Strike, Chain Lightning, Lightning Flash, and Lightning Bolt have a 30% chance to produce a second arc of lightning that strikes the same target for 30% damage.  Additionally, Chain Lightning overwhelms its targets for 45 seconds.  Overwhelmed targets take an additional 10% damage from area attacks.</ns1:description>
