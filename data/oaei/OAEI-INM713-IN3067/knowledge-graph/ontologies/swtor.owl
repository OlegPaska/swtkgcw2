  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Matrix_Shard">
    <rdfs:comment xml:lang="en">Matrix Shards are peices of relics that are housed within datacrons across the galaxy. Once part of larger matrixes, these peices can be retrived from their datacrons and combined together to form a new matrix, giving the user more power to either side of the Force.</rdfs:comment>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Red Matrix Shard</ns5:wikiPageWikiLinkText>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Matrix Shard</ns4:altLabel>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Blue Matrix Shard</ns5:wikiPageWikiLinkText>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Matrix Shard</ns5:wikiPageWikiLinkText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Green Matrix Shard</ns5:wikiPageWikiLinkText>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Datacron"/>
    <ns5:wikiPageWikiLinkText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Yellow Matrix Shard</ns5:wikiPageWikiLinkText>
    <ns3:depiction rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Swtor_2014-11-04_20-24-55-83.png"/>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Datacron"/>
    <ns5:abstract xml:lang="en">Matrix Shards are peices of relics that are housed within datacrons across the galaxy. Once part of larger matrixes, these peices can be retrived from their datacrons and combined together to form a new matrix, giving the user more power to either side of the Force.</ns5:abstract>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Matrix Shard</rdfs:label>
  </rdf:Description>
