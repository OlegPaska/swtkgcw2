  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Xanthe_Elbrick">
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="en">Xanthe Elbrick is a British actress who provided the voice of the female Sith Inquisitor in Star Wars: The Old Republic.
She works mostly in theatre and stage direction for the Edinburgh Footlights Theatre Company in Scotland.

</rdfs:comment>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Star_Wars:_The_Old_Republic"/>
    <rdfs:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Xanthe Elbrick</rdfs:label>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Voice_Actors"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Xanthe Elbrick</ns4:altLabel>
    <ns5:wikiPageWikiLink rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/File:Xanthe-elbrick.jpg"/>
    <ns5:wikiPageExternalLink rdf:resource="http://www.imdb.com/name/nm1287143/"/>
    <ns5:abstract xml:lang="en">Xanthe Elbrick is a British actress who provided the voice of the female Sith Inquisitor in Star Wars: The Old Republic.
She works mostly in theatre and stage direction for the Edinburgh Footlights Theatre Company in Scotland.

</ns5:abstract>
