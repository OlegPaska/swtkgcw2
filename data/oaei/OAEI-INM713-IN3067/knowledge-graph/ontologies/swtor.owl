  <rdf:Description rdf:about="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Suvam_Tan">
    <ns5:thumbnail rdf:resource="http://swtor.wikia.com/wiki/Special:FilePath/Suvam_tan.jpg?width=300"/>
    <ns4:altLabel rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Suvam Tan</ns4:altLabel>
    <ns6:subject rdf:resource="http://dbkwik.webdatacommons.org/swtor.wikia.com/resource/Category:Males"/>
